# ---------------------------------------------------------------
# Database — Amazon RDS for PostgreSQL in AWS, Docker Postgres locally
# ---------------------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL="postgresql://saint:saint@localhost:5432/saint"
# AWS RDS — note sslmode=require:
# DATABASE_URL="postgresql://saintadmin:CHANGE_ME@saint-db.abc123.us-east-1.rds.amazonaws.com:5432/saint?sslmode=require"

DB_POOL_MAX="10"

# Deploy-time migrations (scripts/migrate.mjs). Vercel production builds migrate
# automatically; set MIGRATE_ON_BUILD=1 to also migrate from other builds.
# MIGRATION_DATABASE_URL: a direct (non-pooled) URL for migrations, if DATABASE_URL
# goes through a pooler other than Neon's or Supabase's, which are handled.
# MIGRATE_ON_BUILD=
# MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------
# AWS — leave keys unset on App Runner; the instance role supplies them
# ---------------------------------------------------------------
AWS_REGION="us-east-1"
# Local dev only (or use `aws configure` / SSO instead):
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# S3 bucket that archives uploaded W-9s. Leave blank to skip archiving.
S3_W9_BUCKET=""

# ---------------------------------------------------------------
# Market news provider:  mock | newsapi | rss
# ---------------------------------------------------------------
NEWS_PROVIDER="mock"
NEWS_API_KEY=""
# For NEWS_PROVIDER=rss, {query} is replaced with the URL-encoded company name:
NEWS_RSS_TEMPLATE="https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en"

# ---------------------------------------------------------------
# Alerting (Amazon SES). Leave ALERT_FROM_EMAIL blank to log instead of send.
# ---------------------------------------------------------------
ALERT_FROM_EMAIL=""
DEFAULT_PROCUREMENT_MANAGER_EMAIL=""

# Shared secret for the scheduled batch news refresh endpoint
CRON_SECRET=""

NODE_ENV="development"

# ---------------------------------------------------------------
# Auth  (module: /auth)
# ---------------------------------------------------------------
# Server-side pepper mixed into every password hash. CHANGE THIS in any
# environment that holds real accounts — rotating it invalidates all passwords.
AUTH_PEPPER=change-me-in-production
SESSION_TTL_HOURS=12
# Initial password for the seeded `admin` account (must be changed on first login)
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------
# AI agents  (module: /ai-agents + backend/saint_agents)
# ---------------------------------------------------------------
# Where the Python LangGraph service listens
AGENT_SERVICE_URL=http://127.0.0.1:8000
# Shared secret the agent service presents when calling module tool endpoints.
# Leave blank to disable agent->module calls entirely.
AGENT_TOOL_SECRET=

# Read by the Python service (backend/):
#   APP_BASE_URL=http://127.0.0.1:3000
#   LLM_PROVIDER=ollama          # ollama | openai
#   LLM_MODEL=mistral
#   OPENAI_API_KEY=
#   AGENT_MAX_ITERATIONS=8

# ---------------------------------------------------------------
# Contracts  (module: /contracts)
# ---------------------------------------------------------------
# S3 bucket archiving uploaded MSAs/SOWs. Leave blank to skip archiving.
S3_CONTRACT_BUCKET=

# Logging: debug | info | warn | error  (default: info in production)
LOG_LEVEL=
