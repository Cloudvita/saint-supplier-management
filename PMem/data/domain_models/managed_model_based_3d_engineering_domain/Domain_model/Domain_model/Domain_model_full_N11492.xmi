         <packagedElement xmi:id="_18_4_1_e120334_1499417193171_931282_23716"
                          xmi:uuid="980198b0-014d-4c8a-97c2-e9f891a38f40"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">PartView</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_271a0567_1511358983045_628327_33795"
                       xmi:uuid="a52d965c-c7c9-4e42-ac88-fc3bdda9897d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_271a0567_1511359124559_508071_33810"
                             xmi:uuid="9a91dba6-7451-4164-8ddd-8b6bbc02ba91"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_271a0567_1511358983045_628327_33795"/>
                  <body>the auxiliaryGeometry can only exist if the definingGeometry exists. </body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209556702_428814_162893"
                             xmi:uuid="9a9db255-0525-456b-94a7-a59ad3a887d9"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209556716_514533_162894"
                                xmi:uuid="a70cc95a-0a43-4d77-bda5-cc9d18ff56b8"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//PartView"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(AuxiliaryGeometry) or DefiningGeometry"&gt; PartView WR1 Error on entity &lt;sch:value-of select="$uid"/&gt;: the AuxiliaryGeometry can only exist if the DefiningGeometry exists. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671456343284_855726_163059"
                             xmi:uuid="cd48848f-825d-4e88-b799-55139ea573dd"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671456350004_102051_163060"
                                xmi:uuid="018f8628-a2a0-4144-84ea-2d2a25752da3"
                                xmi:type="uml:Comment">
                     <body>WR1: NOT (EXISTS(AuxiliaryGeometry)) OR EXISTS(DefiningGeometry);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193171_931282_23716"/>
               <specification xmi:id="_18_4_1_271a0567_1511358983046_66546_33796"
                              xmi:uuid="bbe0696a-8c21-4e43-8460-ca988179a6f8"
                              xmi:type="uml:OpaqueExpression">
                  <body>(self.AuxiliaryGeometry-&gt;size() &gt; 0) implies not(self.DefiningGeometry.oclIsUndefined())</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
