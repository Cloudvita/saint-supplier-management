                          xmi:type="uml:Enumeration">
            <ownedComment xmi:id="_18_0_5_45e01bd_1456299496466_733813_42894"
                          xmi:uuid="dcc42605-0514-47df-b05c-b9d4ec692703"
                          xmi:type="uml:Comment">
               <annotatedElement xmi:idref="_18_4_1_e120334_1499417193297_295524_23932"/>
               <body>An InterpolationTypeEnum type lists the possible types of an InterpolatedConfigurationSegment.</body>
            </ownedComment>
            <name>InterpolationTypeEnum</name>
            <ownedAttribute xmi:id="_18_4_1_8db01ea_1516289641693_449810_79137"
                            xmi:uuid="20f8303e-9de4-43b4-85e7-28e17ea4636c"
                            xmi:type="uml:Property">
               <name>arm_mapping</name>
               <visibility>private</visibility>
               <type href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_SYSML_ARM-interpolation_type"/>
               <isReadOnly>true</isReadOnly>
            </ownedAttribute>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_668663_29303"
                          xmi:uuid="e5a71a29-e840-4c9d-b90d-101c856bca9d"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299509542_895278_42895"
                             xmi:uuid="ab06039a-a6ad-4789-901f-c0edd163b28f"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_668663_29303"/>
                  <body> an interpolation in which all pair parameters shall match the set of pair parameter values defined in the next configuration definition.</body>
               </ownedComment>
               <name>undefined_interpolation_type</name>
               <slot xmi:id="_18_4_1_8db01ea_1516289725589_784589_79138"
                     xmi:uuid="be031964-06f8-4245-ac64-ba27752b93cb"
                     xmi:type="uml:Slot">
                  <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
                  <value xmi:id="_18_4_1_8db01ea_1516289725636_154660_79139"
                         xmi:uuid="9f26c6cc-b03e-4789-8587-baa26374343d"
                         xmi:type="uml:InstanceValue">
                     <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-undefined_interpolation_type"/>
                  </value>
               </slot>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_454658_29304"
                          xmi:uuid="ac1cdfbd-3e99-40bf-b9ab-3f7fb9073611"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299519069_690909_42896"
                             xmi:uuid="069fc58b-4829-41ba-92cd-3adeb48fa421"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_454658_29304"/>
                  <body> the pair parameters are changing abruptly.</body>
               </ownedComment>
               <name>discontinuous_interpolation_type</name>
               <slot xmi:id="_18_4_1_8db01ea_1516289738521_531121_79140"
                     xmi:uuid="abc63930-5c0a-4899-887b-461d44b692f2"
                     xmi:type="uml:Slot">
                  <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
                  <value xmi:id="_18_4_1_8db01ea_1516289738537_478841_79141"
                         xmi:uuid="d0caae0d-2723-4683-b7dc-6dff9ef7661e"
                         xmi:type="uml:InstanceValue">
                     <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-discontinuous_interpolation_type"/>
                  </value>
               </slot>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_493508_29305"
                          xmi:uuid="f264b3c7-afac-4786-a96b-51538847c58c"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299528539_330192_42897"
                             xmi:uuid="23b080d2-2b6f-4b32-8871-98fe2599ef9c"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_493508_29305"/>
                  <body> an interpolation in which all pair parameters are interpolated such that the pair parameters pass from one value to the next one at the same rate. The rate may vary proportionally among the pairs.</body>
               </ownedComment>
               <name>synchronous_interpolation_type</name>
               <slot xmi:id="_18_4_1_8db01ea_1516289760564_908400_79142"
                     xmi:uuid="b57a23ae-8d2e-41b9-8ce5-f31db450e16f"
                     xmi:type="uml:Slot">
                  <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
                  <value xmi:id="_18_4_1_8db01ea_1516289760580_721083_79143"
                         xmi:uuid="c7801367-7749-4fde-9abf-abb9159792e8"
                         xmi:type="uml:InstanceValue">
                     <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-synchronous_interpolation_type"/>
                  </value>
               </slot>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_839892_29306"
                          xmi:uuid="4f93c44f-672d-458a-b547-183b26d7435c"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299539029_374915_42898"
                             xmi:uuid="b92e9cfc-1a6e-4741-8d91-915b7ee0110b"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_839892_29306"/>
                  <body> an interpolation in which all pair parameters are interpolated such that the pair parameters pass from one value to the next one at the same rate. The rate remains constant.</body>
               </ownedComment>
               <name>linear_interpolation_type</name>
               <slot xmi:id="_18_4_1_8db01ea_1516289775540_259887_79144"
                     xmi:uuid="529e2fd4-b529-43a7-afa0-6f3585b47884"
                     xmi:type="uml:Slot">
                  <definingFeature xmi:idref="_18_4_1_8db01ea_1516289641693_449810_79137"/>
                  <value xmi:id="_18_4_1_8db01ea_1516289775540_713416_79145"
                         xmi:uuid="cacee56e-44df-48f2-b414-30de91e06c7a"
                         xmi:type="uml:InstanceValue">
                     <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-interpolation_type-linear_interpolation_type"/>
                  </value>
               </slot>
            </ownedLiteral>
         </packagedElement>
         <packagedElement xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                          xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                          xmi:id="_18_4_1_e120334_1499417193298_944628_23933"
                          xmi:uuid="462c9bb1-81dd-4779-8a8c-63ec815e4d5e"
                          xmi:type="uml:Enumeration">
            <ownedComment xmi:id="_18_0_5_45e01bd_1456299558406_215479_42899"
                          xmi:uuid="b9c6d74c-76e6-4874-847e-ef1dd9638a7b"
                          xmi:type="uml:Comment">
               <annotatedElement xmi:idref="_18_4_1_e120334_1499417193298_944628_23933"/>
               <body>A LowOrderKinematicPairTypeEnum type lists the possible types of a LowOrderKinematicPair. The constraints of these pair types shall follow the mathematical definition provided in ISO 10303-105.</body>
            </ownedComment>
            <name>LowOrderKinematicPairTypeEnum</name>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_573383_29308"
                          xmi:uuid="dfe6dc0f-8e5b-47c2-9b71-2f93785148cd"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299573615_155627_42900"
                             xmi:uuid="2b2c2fb8-02f6-4b72-a32e-59aea66dcdd4"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_573383_29308"/>
                  <body> a pair that constrains the motion between two adjacent links to a translation along a common axis and a rotation about it.</body>
               </ownedComment>
               <name>cylindrical_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_344407_29309"
                          xmi:uuid="3ec8c907-75bc-44ed-8c1e-5f84b30e73d8"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299584724_287289_42901"
                             xmi:uuid="e20c15fe-54f2-4fb2-bf26-35de88d162f7"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_344407_29309"/>
                  <body> a pair that prevents any relative motion between two adjacent links. The two pair frames are always forced to coincide.</body>
               </ownedComment>
               <name>fully_constrained_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194145_451705_29310"
                          xmi:uuid="93b8c64b-d296-4fa0-85ae-057d3fe0d404"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299596556_783307_42902"
                             xmi:uuid="f86ed6b1-da23-4ac6-be02-9d5d20c4ba87"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194145_451705_29310"/>
                  <body> a pair that constrains the motion between two adjacent links to translations along the x-axis and y-axis and a rotation about the z-axis. To measure the translations and the angle of rotation, a frame is defined on each of the links such that the x-, y-, and z-axes coincide and the positive directions agree. The translations in x- and y-directions are defined as the displacements required to translate the origin of the first pair frame in positive direction of the x- and y-axes until it coincides with the origin of the second pair frame. The angle of rotation is defined as the angle required to rotate the x-axis of the first pair frame in positive direction around the common z-axis until its direction coincides with the direction of the x-axis of the second pair frame.</body>
               </ownedComment>
               <name>planar_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194146_817337_29311"
                          xmi:uuid="45649414-2ae2-4d16-9b91-62346ac66e7a"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299606672_449347_42903"
                             xmi:uuid="2f0c33e1-2dad-4d90-9b29-367607557e60"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194146_817337_29311"/>
                  <body> a pair that constrains the motion between two adjacent links to a translation along a common axis. To measure the distance of translation a frame is defined on each of the links such that their corresponding coordinate axes coincide and their positive directions agree. The motion of the second link with respect to the first link is defined as the distance required to translate the xy-plane of the first pair frame in positive direction of the common z-axis until it coincides with the xy-plane of the second pair frame.</body>
               </ownedComment>
               <name>prismatic_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194146_767693_29312"
                          xmi:uuid="61c26ad0-8d03-48b0-9f68-fb35ddf44138"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299616269_13361_42904"
                             xmi:uuid="f23258f9-959f-4a39-8704-c921e57f6258"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194146_767693_29312"/>
                  <body> a pair that constrains the motion between two adjacent links to a rotation about a common axis. To measure the angle of rotation a frame is defined on each of the links such that local origins and the z-axes coincide and their positive directions agree. The motion of the second link with respect to the first link is defined as the angle required to rotate the x-axis of the first pair frame in positive direction around the common z-axis until it matches the x-axis of the second pair frame.</body>
               </ownedComment>
               <name>revolute_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194146_694403_29313"
                          xmi:uuid="85f0f9a2-c19c-4740-b490-fda9e6800247"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299629758_115914_42905"
                             xmi:uuid="63832e89-e64a-46c2-b45b-f357d0351806"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194146_694403_29313"/>
                  <body> a pair that constrains the motion between two adjacent links to the rotation about three independent axes that intersect in a common point. To measure the three angles of rotation, a frame system is defined on each of the links such that the origins of the frames coincide. The three angles of rotation are defined as the yaw, pitch, and roll angles. They are required to rotate the x-, y-, and z-axes of the first pair frame until the axis directions of this frame coincide with the axis directions of the second pair frame. </body>
               </ownedComment>
               <name>spherical_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194146_487888_29314"
                          xmi:uuid="ff3b3a4e-6f9b-4ee7-a358-af6cf7a1808a"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299675346_259540_42906"
                             xmi:uuid="ed12da84-8da0-42c0-ae02-042d976da431"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194146_487888_29314"/>
                  <body> a pair that constrains the motion between two adjacent links to the rotation about two independent axes that intersect in a common point. To measure the two angles of rotation, a frame system is defined on each of the links such that the origins of the frames coincide. The two angles of rotation are defined as the yaw and pitch angles. They are required to rotate the y-, and z-axes of the first pair frame until the axis directions of this frame coincide with the axis directions of the second pair frame.</body>
               </ownedComment>
               <name>spherical_pair_with_pin</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194146_18604_29315"
                          xmi:uuid="6c44a629-bbb2-43fa-a9ef-c44ce2f72abe"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299685254_314_42907"
                             xmi:uuid="d463f30c-392d-43d4-a36c-93250610617f"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194146_18604_29315"/>
                  <body> a pair that does not constrain the relative motion between two adjacent links.</body>
               </ownedComment>
               <name>unconstrained_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_e120334_1499417194146_317743_29316"
                          xmi:uuid="572293ac-9e4a-48fa-9aeb-8d7aac8ae59a"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_0_5_45e01bd_1456299695988_326636_42908"
                             xmi:uuid="4aaa9097-1265-4279-98ff-a2a204529596"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417194146_317743_29316"/>
                  <body> a pair that constrains the motion between two adjacent links to two rotations about two intersecting axes.</body>
               </ownedComment>
               <name>universal_pair</name>
            </ownedLiteral>
         </packagedElement>
         <packagedElement xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                          xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                          xmi:id="_19_0_4_b1702d9_1702984618559_111063_66555"
                          xmi:uuid="57b1b06e-a3e2-46e4-a28f-f93ac9c1dcc7"
                          xmi:type="uml:Enumeration">
            <ownedComment xmi:id="_19_0_4_b1702d9_1702984618561_825565_66560"
                          xmi:uuid="1cc63df4-e0e3-4cc1-8c50-c1e743f53ce0"
                          xmi:type="uml:Comment">
               <annotatedElement xmi:idref="_19_0_4_b1702d9_1702984618559_111063_66555"/>
               <body>A KinematicPairWithMotionCouplingTypeEnum type lists the possible types of a KinematicPairWithMotionCoupling.</body>
            </ownedComment>
            <name>KinematicPairWithMotionCouplingTypeEnum</name>
            <ownedLiteral xmi:id="_19_0_4_b1702d9_1702984618560_364724_66556"
                          xmi:uuid="5e25bc54-935c-4c32-b126-54a03e44d38b"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_19_0_4_b1702d9_1702984618561_742103_66562"
                             xmi:uuid="bc31d21c-d388-4918-8c9d-342c06b10042"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702984618560_364724_66556"/>
                  <body> a pair made of two revolute pairs coupled via Radius or via CouplingRatio.</body>
               </ownedComment>
               <name>gear_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_19_0_4_b1702d9_1702984618560_152256_66557"
                          xmi:uuid="e16ee41d-bfcb-4b50-b5cd-14a55257f7c4"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_19_0_4_b1702d9_1702984618561_45186_66563"
                             xmi:uuid="b85ef8d9-3c24-4b8d-b991-015b08c6f7f6"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702984618560_152256_66557"/>
                  <body> a pair that consists of a linear flexible link that moves around a rolling (virtual) pinion where the rotation axis of the pinion is perpendicular to the direction of the linear flexible link. A pair made of two prismatic pairs coupled via Radius or via CouplingRatio.</body>
               </ownedComment>
               <name>linear_flexible_and_pinion_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_19_0_4_b1702d9_1702984618560_318506_66558"
                          xmi:uuid="215e42c5-854c-4f20-982d-f74cc04914f0"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_19_0_4_b1702d9_1702984618561_403996_66564"
                             xmi:uuid="59000b09-dca2-43df-bffa-d9ee036b69ba"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702984618560_318506_66558"/>
                  <body> a pair that describes a pinion rolling on a rack where the rotation axis of the pinion is perpendicular to the direction of the rack. A pair made of one revolute and one prismatic pair coupled via Radius or via CouplingRatio.</body>
               </ownedComment>
               <name>rack_and_pinion_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_19_0_4_b1702d9_1702984706598_742358_66570"
                          xmi:uuid="65111d0b-901d-4f92-8a85-93b7140085d1"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_19_0_4_b1702d9_1704730232120_102695_60180"
                             xmi:uuid="c938a499-4fde-49d4-9ddc-f10b0d03ff0d"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702984706598_742358_66570"/>
                  <body>a pair made of two universal pairs where the rotation of input axis and output axis are uniform. The Rotation axis of Pairs[1].Link1 and Pairs[2].Link2 shall be parallel. Pairs[1].Link2 and Pairs[2].Link1 shall reference either the same Occurrence of a Part, or both Occurrences shall be joined via a fully_constrained_pair. In the latter case, three Pairs are involved: universal_pair, fully_constrained_pair and universal_pair. </body>
               </ownedComment>
               <name>composed_homokinetic_pair</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_19_0_4_b1702d9_1702984805938_667170_66571"
                          xmi:uuid="7976fdf4-de0b-49aa-9810-827800db6f0e"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_19_0_4_b1702d9_1704730387841_208371_60187"
                             xmi:uuid="5cec4efd-da48-43bf-bf23-c054c0ed53d9"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702984805938_667170_66571"/>
                  <body>a pair made of one revolute_pair, prismatic_pair, or cylindrical_pair driving the motion of one other revolute_pair, prismatic_pair, or cylindrical_pair coupled via a Radius or via a CouplingRatio. &lt;note&gt; gear_pair and rack_and_pinion_pair are simple cases of this kind of pair. &lt;/note&gt;</body>
               </ownedComment>
               <name>two_joint_coupler</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_19_0_4_b1702d9_1702984843449_14573_66572"
                          xmi:uuid="3364180b-cced-41ee-bacc-7082deee8d74"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_19_0_4_b1702d9_1704730434278_79574_60192"
                             xmi:uuid="9fbeeadd-89a4-4c3f-9c40-e9a1fa0488f3"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702984843449_14573_66572"/>
                  <body>a pair made of one revolute_pair, prismatic_pair, or cylindrical_pair driving the motion of two other revolute_pairs, prismatic_pairs, and/or cylindrical_pairs coupled via two Radius or via two CouplingRatios</body>
               </ownedComment>
               <name>three_joint_coupler</name>
            </ownedLiteral>
         </packagedElement>
         <packagedElement xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
