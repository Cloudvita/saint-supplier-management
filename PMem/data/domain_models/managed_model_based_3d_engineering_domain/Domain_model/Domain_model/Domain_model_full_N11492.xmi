                     <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-actuated_direction-positive_only"/>
                  </value>
               </slot>
            </ownedLiteral>
            <ownedLiteral xmi:id="_19_0_4_2840147_1723463047258_200975_61382"
                          xmi:uuid="e69c1565-c5aa-4515-ba9c-580f5364dd2e"
