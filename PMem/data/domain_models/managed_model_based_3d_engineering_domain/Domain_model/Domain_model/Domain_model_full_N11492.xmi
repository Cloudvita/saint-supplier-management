                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_91401df_1716555411924_129911_133988"/>
                  <body>the side of a surface which is in the same direction as the surface normal.</body>
               </ownedComment>
               <name>positive</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_91401df_1716555451459_503172_133991"
                          xmi:uuid="7ed9a1a2-6a5b-4c42-95e5-062298fe710a"
