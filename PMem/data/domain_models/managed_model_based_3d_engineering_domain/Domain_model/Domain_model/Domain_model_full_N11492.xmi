                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">PropertyValueAssignmentRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459331857065_671749_42709"
                       xmi:uuid="f53dee7e-a342-48f0-bcd4-fe6032c1d21e"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121476_539590_163092"
                             xmi:uuid="65ab1233-c2cd-43e3-ab43-5bc92be873a6"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121476_153002_163093"
                                xmi:uuid="05c28bbb-f2f0-409e-bb7e-512d94ab2573"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//PropertyValueAssignmentRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related PropertyValueAssignment and the relating PropertyValueAssignment shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:PropertyValueAssignmentRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459331895122_205686_42711"
                             xmi:uuid="69a1a1ec-b4e2-4428-a0ef-3ee6e3ad5249"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331857065_671749_42709"/>
                  <body>the related PropertyValueAssignment and the relating PropertyValueAssignment shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121476_326546_163094"
                             xmi:uuid="af375b3f-5309-4fde-a28a-fcb2f9ab027c"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121476_476726_163095"
                                xmi:uuid="7b7d7c42-f8ce-4917-8deb-d98b0c5d4471"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193212_788120_23792"/>
               <specification xmi:id="_18_4_1_271a0567_1509116458868_763105_31510"
                              xmi:uuid="1f865cf0-1731-4dc1-bf15-f602345812e0"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
