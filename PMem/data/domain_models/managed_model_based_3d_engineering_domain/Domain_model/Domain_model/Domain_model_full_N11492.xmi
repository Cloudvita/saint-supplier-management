         <packagedElement xmi:id="_18_4_1_e120334_1499417193221_621784_23808"
                          xmi:uuid="df048827-28fc-4db1-86b4-d5431a3b7a11"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">Representation</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_2_8db01ea_1463065997181_452684_49818"
                       xmi:uuid="ad9d67d0-0976-4a47-be2a-cea9efb99517"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943629_803676_151466"
                             xmi:uuid="65aa7e4f-bb85-4926-85bb-3c78fdf21745"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943629_869757_151467"
                                xmi:uuid="ee14c3da-4566-4a45-8aef-265dbdfb32ea"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//Representation[@uid]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="@xsi:type and (substring-after(@xsi:type,':')!='Representation') or child::Name"&gt;(Representation WR1 &lt;sch:value-of select="$uid"/&gt;) if SELF is exact instance of Representation, then Name shall be provided.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_2_8db01ea_1463066051894_168363_49820"
                             xmi:uuid="c574aa24-4f70-4c95-bed1-f74b0f782a0c"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_271a0567_1517566053200_761697_122544"
                                xmi:uuid="10d5bfd0-ca11-4952-98bf-44e7569752e7"
                                xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="_18_0_2_8db01ea_1463066051894_168363_49820"/>
                     <body>EXISTS(Name) OR (TYPEOF(SELF\Representation) &lt;&gt; TYPEOF(SELF))</body>
                  </ownedComment>
                  <annotatedElement xmi:idref="_18_0_2_8db01ea_1463065997181_452684_49818"/>
                  <body>if SELF is exact instance of Representation, then Name shall be provided.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193221_621784_23808"/>
               <specification xmi:id="_18_4_1_8db01ea_1513241984567_221186_44300"
                              xmi:uuid="8452ccc9-350a-4e74-8a22-7faef31383f3"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.oclIsTypeOf(Application_protocols::AP242::Domain_model::RepresentationAndExternalElementReference::Representation) implies not self.Name.oclIsUndefined()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
