               <type xmi:idref="_18_4_1_e120334_1499417193242_442446_23839"/>
               <lowerValue xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                           xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
