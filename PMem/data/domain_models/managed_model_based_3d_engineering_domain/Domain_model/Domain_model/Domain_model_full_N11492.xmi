         <packagedElement xmi:id="_18_4_1_e120334_1499417193174_913820_23720"
                          xmi:uuid="29454f74-64f1-4b81-a2a7-18a7d1722fe6"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">Path</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_2_8db01ea_1463066423936_843015_49931"
                       xmi:uuid="6a55824b-e2bc-4296-9d52-d7992635b7a9"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_91401df_1713966165297_510413_138395"
                             xmi:uuid="6059dec4-1946-4964-915e-41519b761543"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_91401df_1713966174760_741937_138396"
                                xmi:uuid="5f79af48-59e0-43c5-9f66-8dc306a074df"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='Path']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="edgeList" value="child::EdgeList/Edge/@uidRef"/&gt; &lt;sch:assert test="every $j in for $i in $edgeList return ( (if ((child::OrientationList/Boolean[index-of($edgeList, $i)]) eq 'true' ) then //*[@uid=$i]/EdgeEnd/@uidRef else //*[@uid=$i]/EdgeStart/@uidRef) eq (if (child::OrientationList/Boolean[1+index-of($edgeList, $i) ] eq 'true') then //*[@uid=$edgeList[1+index-of($edgeList, $i)]]/EdgeStart/@uidRef else //*[@uid=$edgeList[1+index-of($edgeList, $i)]]/EdgeEnd/@uidRef )) satisfies $j=true()"&gt;(Path.WR1 &lt;sch:value-of select="$uid"/&gt;) the end Vertex of each Edge (&lt;sch:value-of select="$edgeList"/&gt;) shall be the same as the start Vertex of its successor.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_2_8db01ea_1463066462740_880452_49933"
                             xmi:uuid="aff8512d-6819-4113-9123-77989e3484c7"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_271a0567_1539248044785_115872_102817"
                                xmi:uuid="38769a0b-ebbc-4d98-ae01-1e96503d80f2"
                                xmi:type="uml:Comment">
                     <annotatedElement xmi:idref="_18_0_2_8db01ea_1463066462740_880452_49933"/>
                     <body>path_aligned(SELF)</body>
                  </ownedComment>
                  <annotatedElement xmi:idref="_18_0_2_8db01ea_1463066423936_843015_49931"/>
                  <body>the end Vertex of each Edge shall be the same as the start Vertex of its successor. </body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193174_913820_23720"/>
               <specification xmi:id="_18_4_1_8db01ea_1513345488287_637166_76181"
                              xmi:uuid="6f772fd5-5b12-4125-b0bb-f8242b31876f"
                              xmi:type="uml:OpaqueExpression">
                  <body>Sequence{1..self.EdgeList-&gt;size()-1} -&gt;forAll(i | self.EdgeList-&gt;asSequence()-&gt;at(i).EdgeEnd = self.EdgeList-&gt;asSequence()-&gt;at(i+1).EdgeStart)</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_8db01ea_1551372925394_394938_121458"
                            xmi:uuid="1113f1fa-a8db-4117-8d53-255df6d4ae97"
                            xmi:type="uml:Generalization">
               <general xmi:idref="_18_4_1_e120334_1499417193179_295269_23733"/>
            </generalization>
