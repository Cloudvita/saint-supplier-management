                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">TimeIntervalWithBounds</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459333130066_81466_42752"
                       xmi:uuid="0271cc6e-06ea-404b-aa77-71eed446c642"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459333171150_602855_42754"
                             xmi:uuid="0b8e80d0-ca46-4513-be81-51b2ccc691da"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333130066_81466_42752"/>
                  <body> either a Duration or a SecondaryBound can be specified.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1721295759191_879294_151312"
                             xmi:uuid="18ea7771-caf1-4a30-a5f8-fd9da982f0ca"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721295759191_783825_151313"
                                xmi:uuid="b6a6be8b-32fe-44fb-bdd7-76b6927e8f9c"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='TimeIntervalWithBounds']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(Duration) or not(SecondaryBound)"&gt; Either a Duration or a SecondaryBound can be specified. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671462141257_835476_163083"
                             xmi:uuid="53ca5803-1fb1-4f90-a3bd-c0551cf16883"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671462149012_987990_163084"
                                xmi:uuid="b07ee188-c03e-44d7-8e04-253f64fe9069"
                                xmi:type="uml:Comment">
                     <body>WR1: NOT (EXISTS (SecondaryBound) AND EXISTS (Duration));</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193271_708558_23883"/>
               <specification xmi:id="_18_4_1_271a0567_1509106584142_717046_30322"
                              xmi:uuid="a0e8c4c2-40bc-44dd-aac9-4c3708b19774"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.SecondaryBound.oclIsUndefined() or self.Duration.oclIsUndefined()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459333178354_556674_42755"
                       xmi:uuid="9c66fca2-8d21-469d-9779-124a49529c10"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671462164049_433195_163085"
                             xmi:uuid="5d5f97ff-32e8-41fc-a354-b06c88efa0a5"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671462170441_261050_163086"
                                xmi:uuid="ac62f6ea-4999-47ff-a445-e5504331d7df"
                                xmi:type="uml:Comment">
                     <body>WR2: EXISTS (PrimaryBound) OR EXISTS (SecondaryBound);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459333212200_801540_42757"
                             xmi:uuid="c52e9424-38be-4df4-bd19-0a793dd209a9"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333178354_556674_42755"/>
                  <body> at least one bound has to be specified.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1721295759184_443179_151310"
                             xmi:uuid="f28cd4d4-7b0a-4702-903f-ba4fe8e19fe0"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721295759184_315936_151311"
                                xmi:uuid="2156cfa3-b398-44ee-b957-35ca40ab5f3c"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='TimeIntervalWithBounds']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="PrimaryBound or SecondaryBound"&gt; At least one bound has to be specified. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR2</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193271_708558_23883"/>
               <specification xmi:id="_18_4_1_271a0567_1509106908448_733301_30361"
                              xmi:uuid="4a736099-0016-430d-9c26-a74efbcf1989"
                              xmi:type="uml:OpaqueExpression">
                  <body>not(self.PrimaryBound.oclIsUndefined()) or not(self.SecondaryBound.oclIsUndefined())</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
