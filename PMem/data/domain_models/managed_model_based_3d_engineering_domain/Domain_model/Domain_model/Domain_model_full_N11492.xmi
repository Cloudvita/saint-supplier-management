         <packagedElement xmi:id="_18_4_1_af4021f_1601394052700_635739_100394"
                          xmi:uuid="49cfffff-8f94-45d5-9ca1-a0156c238cfd"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">DirectedToleranceZone</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_91401df_1717136386619_287534_132753"
                       xmi:uuid="1caacc4a-2bb9-4930-a2fd-715c3fd0a40e"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_91401df_1717136405320_648810_132755"
                             xmi:uuid="09febd37-aeab-4eba-b6e8-25ddbd9b5e83"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_91401df_1717136386619_287534_132753"/>
                  <body>if Angle is defined, the unit of Angle shall be a plane angle measure unit.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_91401df_1717136796248_298237_132775"
                             xmi:uuid="488c4ae0-46fc-4fd6-b82a-57e53d6dabac"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_91401df_1717139990989_260762_132794"
                                xmi:uuid="8b6265d2-ee12-4f53-ad00-c974f0245825"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//ShapeElement[substring-after(@xsi:type,':')='DirectedToleranceZone']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="unitRef" value="child::Angle/Unit/@uidRef"/&gt; &lt;sch:assert test="not (Angle) or //Unit[@uid=$unitRef]/Quantity[(ClassString ='plane angle')]"&gt;(DirectedToleranceZone.WR1 &lt;sch:value-of select="$uid"/&gt;) if Angle is defined, the unit of Angle shall be a plane angle measure unit.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052700_635739_100394"/>
               <specification xmi:id="_18_4_1_91401df_1717136386620_73459_132754"
                              xmi:uuid="89100d42-1b86-4700-9d49-2f5821842885"
                              xmi:type="uml:OpaqueExpression">
                  <body>not (self.Angle.oclIsUndefined()) implies (self.Angle.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value = 'plane angle')</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
