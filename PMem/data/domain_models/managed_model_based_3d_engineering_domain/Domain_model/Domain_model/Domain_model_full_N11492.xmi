                                xmi:uuid="95d8feb0-c012-47be-8fc1-10006e20558b"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(Axis) or count(tokenize(normalize-space(Axis), ' '))=3"&gt; (AxisPlacement_AxisLowerBound &lt;sch:value-of select="$uid"/&gt;) if Axis is defined, its dimensionality shall be 3.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>AxisLowerBound</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_577371_23412"/>
               <specification xmi:id="_18_4_1_e120334_1499417194233_574044_30100"
                              xmi:uuid="99f58dad-dbfd-4931-9103-819babd0dd90"
                              xmi:type="uml:OpaqueExpression">
                  <body>Axis-&gt;isEmpty() xor (Axis-&gt;size() = 3)</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459325360409_788525_42463"
                       xmi:uuid="c467e55f-4eeb-45fa-b008-0d3b03a6b0c4"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459325415766_732034_42465"
                             xmi:uuid="57ad9cf8-eb13-4c54-ad34-1202cd50437f"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325360409_788525_42463"/>
                  <body>if Axis is defined, its dimensionality and the dimensionality of Position shall be 3.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671446190255_473151_162899"
                             xmi:uuid="e1e71407-79ca-4c7e-a48c-886823540826"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671446197874_858879_162900"
                                xmi:uuid="f39149ff-88df-49b9-be41-1e5da2dc04fe"
                                xmi:type="uml:Comment">
                     <body>WR2: NOT(EXISTS(Axis)) OR (SIZEOF(Axis) = SIZEOF(Position));</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943638_528134_151468"
                             xmi:uuid="e5068546-0d3b-4769-8a53-0ff75a3be40a"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943638_868025_151469"
                                xmi:uuid="6797ef16-3185-462d-be47-2e4d31cb43f9"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(Axis) or (count(tokenize(normalize-space(Axis), ' '))= 3 and count(tokenize(normalize-space(Position), ' '))=3)"&gt; (AxisPlacement_WR2 &lt;sch:value-of select="$uid"/&gt;) if Axis is defined, its dimensionality and the dimensionality of Position shall be 3.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR2</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_577371_23412"/>
               <specification xmi:id="_18_4_1_271a0567_1509024049321_57840_30117"
                              xmi:uuid="d8d1855a-2d4b-4146-9bd6-38f0386bada3"
                              xmi:type="uml:OpaqueExpression">
                  <body>(self.Axis-&gt;size() &gt; 0) implies (self.Axis-&gt;size() = 3 and self.Position-&gt;size() = 3)</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
