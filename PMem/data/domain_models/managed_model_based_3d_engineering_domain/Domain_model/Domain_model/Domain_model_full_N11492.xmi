         <packagedElement xmi:id="_18_4_1_e120334_1499417193157_128516_23688"
                          xmi:uuid="d0fb900a-ca08-4da0-98c0-b134d9178bc0"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">OccurrenceRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459330245136_611720_42645"
                       xmi:uuid="079b08e9-0890-4593-85fc-4bbe30d36c4c"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121158_267754_162998"
                             xmi:uuid="44dbfde1-2377-4342-adcd-7127c1a94e96"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121158_828095_162999"
                                xmi:uuid="bc71a8a2-d4de-43b2-b406-73269022317c"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121156_936967_162996"
                             xmi:uuid="67fcc3e4-044e-42b8-b21d-1428f5fadc47"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121157_499405_162997"
                                xmi:uuid="92678370-9d47-4970-934b-5bfd854daa49"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//OccurrenceRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Occurrence and the relating Occurrence shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:OccurrenceRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459330276942_37661_42647"
                             xmi:uuid="ca635253-78f6-43de-8708-febc1278df7e"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330245136_611720_42645"/>
                  <body>the related Occurrence and the relating Occurrence must be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193157_128516_23688"/>
               <specification xmi:id="_18_4_1_271a0567_1509114963335_421288_31309"
                              xmi:uuid="ba5533c5-787c-43eb-ac0c-7305f72d7d74"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
