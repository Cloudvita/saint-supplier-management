                          xmi:uuid="5d1d05d2-44dc-437f-a866-c9a406c18896"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_19_0_4_2840147_1723462948695_822285_61373"
                             xmi:uuid="1fb8fb53-031b-47a2-87c5-5867e57f0d32"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723462948691_700525_61362"/>
                  <body>indicates that the actuation is around the z-axis.</body>
               </ownedComment>
               <name>Rz</name>
               <slot xmi:id="_19_0_4_2840147_1723462948695_918909_61372"
                     xmi:uuid="1ee6fb8d-5257-47bb-a63d-b78c59a04199"
