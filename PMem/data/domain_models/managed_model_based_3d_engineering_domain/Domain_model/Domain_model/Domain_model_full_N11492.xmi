         <packagedElement xmi:id="_18_4_1_af4021f_1601394052817_254498_100864"
                          xmi:uuid="f7a3498d-5146-4874-bfdc-fb96e7c2076b"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">CircularRunoutTolerance</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_af4021f_1676995251827_300279_156267"
                       xmi:uuid="ee490a43-4b7c-46f0-899a-ccbf05b7aabe"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_af4021f_1676995285206_165557_156269"
                             xmi:uuid="048ef3e6-7e3b-4123-820d-0c63ff890e29"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_af4021f_1676995251827_300279_156267"/>
                  <body>the unit of Angle shall be a plane angle measure unit.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_af4021f_1676995607517_129925_156343"
                             xmi:uuid="68b3af7e-117b-474e-b072-f226d19b0523"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_af4021f_1676995617854_850213_156344"
                                xmi:uuid="825db10b-226b-419a-836a-cab46c158062"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//GeometricTolerance[substring-after(@xsi:type,':')='CircularRunoutTolerance']/Angle"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="unitRef" value="./Unit/@uidRef"/&gt; &lt;sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='plane angle'"&gt;(CircularRunoutTolerance &lt;sch:value-of select="$uid"/&gt;) The unit of Angle shall be a plane angle measure unit. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052817_254498_100864"/>
               <specification xmi:id="_18_4_1_af4021f_1676995251828_512098_156268"
                              xmi:uuid="04a915dd-aab4-4195-912a-543c31d2d30f"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Angle.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value ='plane angle'</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_af4021f_1601394052938_376375_102081"
                            xmi:uuid="4a918882-6133-4c45-8e12-f08a25ada961"
                            xmi:type="uml:Generalization">
