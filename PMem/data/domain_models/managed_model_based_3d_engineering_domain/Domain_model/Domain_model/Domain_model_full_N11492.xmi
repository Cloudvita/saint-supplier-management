            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">OverRidingStyledElement</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_91401df_1718366357230_920573_132933"
                       xmi:uuid="675469d9-3f35-4342-835f-98f4548bbb5a"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_91401df_1718370010562_677369_132969"
                             xmi:uuid="8beaf914-03f4-40ff-8db4-dfaaae3c2b0e"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_91401df_1718370021692_857740_132970"
                                xmi:uuid="1f71e552-52b8-47a8-8b0e-c77a579b7a23"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//RepresentationItem[@uid and local-fn:testXsiTypeOverRidingStyledElement(@xsi:type)=true()]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="child::Appearance or child::Invisible"&gt;(OverRidingStyledElement.WR1 &lt;sch:value-of select="$uid"/&gt;) the Appearance shall be defined or the Invisible shall be defined.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_91401df_1718366384410_51569_132935"
                             xmi:uuid="989f8ff3-7612-424a-a499-b1c020d23289"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_91401df_1718366357230_920573_132933"/>
                  <body>the Appearance shall be defined or the Invisible shall be defined.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_91401df_1620052000325_393917_93763"/>
               <specification xmi:id="_18_4_1_91401df_1718366357230_398754_132934"
                              xmi:uuid="650e7b05-a77a-43e4-85ea-228c6c76279f"
                              xmi:type="uml:OpaqueExpression">
                  <body>not (self.Appearance.oclIsUndefined()) or not (self.Invisible.oclIsUndefined())</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_91401df_1620052026342_909101_93808"
