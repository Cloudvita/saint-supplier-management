         <packagedElement xmi:id="_18_4_1_e120334_1499417193271_720836_23882"
                          xmi:uuid="3868e811-e407-4b92-bcc7-36615e564613"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">TimeIntervalRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459332569691_205084_42739"
                       xmi:uuid="8b756c66-7575-4dc7-8d6d-6d1a9b7c1b8d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459332599905_443350_42741"
                             xmi:uuid="165f9384-7a16-4654-b5d9-b6acc172053f"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332569691_205084_42739"/>
                  <body>the related TimeInterval and the relating TimeInterval shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121498_969785_163098"
                             xmi:uuid="727391fd-1064-4365-986d-bb02195a67d8"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121498_162862_163099"
                                xmi:uuid="98d71bc8-3e8e-4d47-802d-9af8b503e57b"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121497_736202_163096"
                             xmi:uuid="d3647ac7-039a-40ce-bcef-ac40ddeccfe1"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121497_192902_163097"
                                xmi:uuid="7321ccd0-fd60-4394-be06-2cd68a0dc1b3"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//TimeIntervalRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related TimeInterval and the relating TimeInterval shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:TimeIntervalRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193271_720836_23882"/>
               <specification xmi:id="_18_4_1_271a0567_1509117012781_448316_31611"
                              xmi:uuid="f75efdc8-6719-46d6-9857-8f9cacc08112"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
