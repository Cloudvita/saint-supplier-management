         <packagedElement xmi:id="_18_4_1_e120334_1499417193290_559728_23918"
                          xmi:uuid="d76d1a5f-c64b-456f-aa91-a27f63282427"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">WorkOrderRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459333467376_909997_42764"
                       xmi:uuid="9471bff0-6c5f-4bf9-8afc-f9888418b777"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121694_48764_163118"
                             xmi:uuid="2aa7b4de-2fbc-40fe-b9c9-b744c820295b"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121694_400847_163119"
                                xmi:uuid="609062c2-edd7-42e9-85fc-4ace89ffb588"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121693_814480_163116"
                             xmi:uuid="410cea70-e982-4cbc-9473-914f934a70a0"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121693_678713_163117"
                                xmi:uuid="84c6d1d8-1c2d-405c-ab16-10c72cb6e042"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//WorkOrderRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related WorkOrder and the relating WorkOrder shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:WorkOrderRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459333501147_49972_42766"
                             xmi:uuid="fa7f0f06-4552-4a82-81a4-2d71148c06b1"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333467376_909997_42764"/>
                  <body>the related WorkOrder and the relating WorkOrder shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193290_559728_23918"/>
               <specification xmi:id="_18_4_1_271a0567_1509117454535_498435_31636"
                              xmi:uuid="10fe6e73-4709-4e2d-9d2e-cd462da7c6ed"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
