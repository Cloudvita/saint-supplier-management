            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">PersonInOrganizationRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459330620584_414072_42660"
                       xmi:uuid="a9478f3e-4b40-463d-b2b3-33ebe4888e04"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121954_39220_163196"
                             xmi:uuid="39cf40cb-e44e-42a5-be72-055df93711af"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121955_505395_163197"
                                xmi:uuid="8ff2e35f-d66c-47c6-886b-4555feec4aa8"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//PersonInOrganizationRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related PersonInOrganization and the relating PersonInOrganization shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:PersonInOrganizationRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121955_466802_163198"
                             xmi:uuid="88ad31b1-c6b2-43e0-a540-1104471265ec"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121955_191258_163199"
                                xmi:uuid="dffe349a-b308-4bad-a0f9-ad302de4e9c7"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459330651916_940742_42662"
                             xmi:uuid="b79ff777-9a28-4845-bfab-1ee83a792eb4"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330620584_414072_42660"/>
                  <body>the related PersonInOrganization and the relating PersonInOrganization shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193178_874694_23728"/>
               <specification xmi:id="_18_4_1_271a0567_1509115889683_335244_31387"
                              xmi:uuid="d6da2938-39c5-4851-add4-d44777e41a12"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
