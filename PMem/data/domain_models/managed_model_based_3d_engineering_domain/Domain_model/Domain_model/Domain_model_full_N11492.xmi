                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">TransformationSelect</name>
