                       xmi:uuid="15b59807-787c-44d3-8209-550766ae931d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_91401df_1677075018704_40798_155633"
                             xmi:uuid="d6ca41cf-816e-4fbc-a8f7-ec7a65f4af7b"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_91401df_1677074988980_761902_155631"/>
                  <body>the unit of UnitLength shall be a length measure unit.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_91401df_1677075069904_80727_155643"
                             xmi:uuid="f68a490a-4e02-48ae-bc82-f61a160200ae"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_91401df_1677075081665_909017_155644"
                                xmi:uuid="f4f7e23d-8827-4e3b-8d5d-2e7d17bbcf4d"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//GeometricDimension/UnitLength"&gt; &lt;sch:let name="uid" value="../@uid"/&gt; &lt;sch:let name="unitRef" value="./Unit/@uidRef"/&gt; &lt;sch:assert test="//Unit[@uid=$unitRef]/Quantity/ClassString ='length'"&gt;(GeometricDimension &lt;sch:value-of select="$uid"/&gt;) The unit of UnitLength shall be a length measure unit.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_af4021f_1601394052934_893030_101947"/>
               <specification xmi:id="_18_4_1_91401df_1677074988980_525092_155632"
                              xmi:uuid="7787185d-629d-4ada-a4b5-af34b68cb3c1"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.UnitLength.Unit.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::Unit).Quantity.oclAsType(Application_protocols::AP242::Domain_model::CommonResources::ClassStringProxy).value ='length'</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
