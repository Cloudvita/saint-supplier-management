         <packagedElement xmi:id="_19_0_4_b1702d9_1702978920923_682940_64028"
                          xmi:uuid="a5ce3bc5-4fbb-402d-80ae-39afc87ff826"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">KinematicPairWithMotionCoupling</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723209315570_868062_60630"
                       xmi:uuid="0052e9ba-4b84-46f1-91fe-553980350dc2"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723209396974_896208_60632"
                             xmi:uuid="3ec9f758-a7a0-46d6-98e8-b09623eb6c08"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723209315570_868062_60630"/>
                  <body>Scales shall be either undefined or its size shall be greater or equal 2.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723209315581_941146_60631"
                              xmi:uuid="cd3a225f-c0d7-421f-b2fb-51f3e10bc16d"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Scales-&gt;isEmpty() xor (Scales-&gt;size() &gt;= 2)</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723210788551_199564_60698"
                       xmi:uuid="0dbc389f-cabf-49a1-a9dd-a339d5db7a41"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723210804501_954110_60700"
                             xmi:uuid="9e1cc913-9c9d-43e6-8759-cd572665b0d6"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723210788551_199564_60698"/>
                  <body>for 'gear_pair', 'linear_flexible_and_pinion_pair' and 'gear_pair', Link1 of both coupled pairs may be the BaseLink of the Mechanism or the same non-BaseLink part or different, but both Link2 have to be different.</body>
               </ownedComment>
               <name>IP16</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723210788555_724011_60699"
                              xmi:uuid="269723cf-4ecb-45fb-bcb0-ecef97990b6b"
                              xmi:type="uml:OpaqueExpression">
                  <body>For 'gear_pair', 'linear_flexible_and_pinion_pair' and 'gear_pair', Link1 of both coupled pairs may be the BaseLink of the Mechanism or the same non-BaseLink part or different, but both Link2 have to be different.</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723209941605_541310_60637"
                       xmi:uuid="31fc7f6e-8fa9-4f79-93f4-583f47eabfa7"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723209986942_266737_60639"
                             xmi:uuid="e81ba2a6-0b26-4e77-8851-718bfb9632bd"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723209941605_541310_60637"/>
                  <body>CouplingTypes shall be either undefined or its size shall be greater or equal 2.</body>
               </ownedComment>
               <name>WR2</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723209941612_152645_60638"
                              xmi:uuid="3fac1165-4dfe-491e-9a64-7cf45d078a26"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.CouplingTypes-&gt;isEmpty() xor (CouplingTypes-&gt;size() &gt;= 2)</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723210543561_105952_60677"
                       xmi:uuid="3577d360-b05c-470b-a4cf-5e3c027afeff"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723210556296_792153_60679"
                             xmi:uuid="41fcf4ce-e2b2-4373-9598-13f36d6511fb"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723210543561_105952_60677"/>
                  <body>if the Z axles have opposite directions, the related Scale shall have a negative value.</body>
               </ownedComment>
               <name>IP9</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723210543566_667672_60678"
                              xmi:uuid="ec55dd88-b2e1-4e2f-8887-774b30fbb5a5"
                              xmi:type="uml:OpaqueExpression">
                  <body>If the Z axles have opposite directions, the related Scale shall have a negative value.</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723210285577_902213_60659"
                       xmi:uuid="5986ccb2-ad9d-4b6a-9131-e08c3fd7929d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723210355740_365683_60661"
                             xmi:uuid="925d435a-c697-47e5-b044-8f589fd10efd"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723210285577_902213_60659"/>
                  <body>the value of Scales[n] shall apply to the pair mapped to Pairs[n].</body>
               </ownedComment>
               <name>IP3</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723210285581_470487_60660"
                              xmi:uuid="5140bc06-4094-47dc-b797-ce87a5043b69"
                              xmi:type="uml:OpaqueExpression">
                  <body>The value of Scales[n] shall apply to the pair mapped to Pairs[n].</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723210676091_444801_60689"
                       xmi:uuid="59e9d61d-95cc-42b6-b557-06a03a328e07"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723210696183_986534_60691"
                             xmi:uuid="ededd542-d1a4-4c05-95e1-fcce27725c74"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723210676091_444801_60689"/>
                  <body>for 'gear_pair', either CouplingRatios[1] or Radius[1] and Radius[2] should be mapped, since both values are related to each other: the conversion formula between both is: CouplingRatio = Radius1/Radius2.</body>
               </ownedComment>
               <name>IP13</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723210676099_507889_60690"
                              xmi:uuid="def78f0b-fb4c-4459-b499-d1d1cb4e8ba3"
                              xmi:type="uml:OpaqueExpression">
                  <body>For 'gear_pair', either CouplingRatios[1] or Radius[1] and Radius[2] should be mapped, since both values are related to each other: the conversion formula between both is: CouplingRatio = Radius1/Radius2.</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723210598644_737945_60683"
                       xmi:uuid="5c2c7ead-edc2-4724-ae09-3f1e5881599b"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723210614272_183654_60685"
                             xmi:uuid="4c43fcd3-4a4f-4904-8bc9-e1bb643ad9b5"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723210598644_737945_60683"/>
                  <body>for 'rack_and_pinion_pair', either CouplingRatios[1] or Radius[1] should be mapped, since both values are related to each other: the conversion formula between both is: CouplingRatio = 2 * PI * Radius.</body>
               </ownedComment>
               <name>IP11</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723210598647_218852_60684"
                              xmi:uuid="e9151d44-7c9b-4284-8881-a01ef306fb99"
                              xmi:type="uml:OpaqueExpression">
                  <body>For 'rack_and_pinion_pair', either CouplingRatios[1] or Radius[1] should be mapped, since both values are related to each other: the conversion formula between both is: CouplingRatio = 2 * PI * Radius.</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_2840147_1723210408763_795494_60665"
                       xmi:uuid="63c64278-662e-4fec-b03c-8429fb534de5"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_2840147_1723210426276_712192_60667"
                             xmi:uuid="9d42a0b2-83e1-41e1-8561-c038d7e65e93"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_2840147_1723210408763_795494_60665"/>
                  <body>if Pairs[n] includes multiple DOFs like 'cylindrical_pair', one of 'rotation' or 'translation' has to be chosen for CouplingTypes[n].</body>
               </ownedComment>
               <name>IP5</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702978920923_682940_64028"/>
               <specification xmi:id="_19_0_4_2840147_1723210408765_681208_60666"
                              xmi:uuid="82abb0bc-a53b-4e02-be5d-584c866460ca"
                              xmi:type="uml:OpaqueExpression">
                  <body>If Pairs[n] includes multiple DOFs like 'cylindrical_pair', one of 'rotation' or 'translation' has to be chosen for CouplingTypes[n].</body>
                  <language>English</language>
               </specification>
            </ownedRule>
