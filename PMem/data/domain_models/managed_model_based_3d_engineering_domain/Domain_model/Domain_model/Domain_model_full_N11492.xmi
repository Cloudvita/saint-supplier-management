         <packagedElement xmi:id="_18_4_1_e120334_1499417193215_39216_23797"
                          xmi:uuid="175ea3e4-33aa-41ed-abdd-e4098005e5bf"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ProxyRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459331998365_100617_42715"
                       xmi:uuid="118d4db6-aa31-4111-8739-6978b2b70262"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121446_337383_163086"
                             xmi:uuid="4c9ea65a-c4bb-4f2c-81de-4c613d1bc5d4"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121447_617883_163087"
                                xmi:uuid="0749701e-7ad2-41a3-a1db-2535aa900769"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459332027221_580254_42717"
                             xmi:uuid="653fdb26-6799-439c-ba82-1ade83cd3c18"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331998365_100617_42715"/>
                  <body>the related Proxy and the relating Proxy shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121446_141980_163084"
                             xmi:uuid="fe7a1a58-e1c4-4bc8-a856-96146a190281"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121446_473866_163085"
                                xmi:uuid="271602c6-502b-4141-99e1-2a08c10ea7b5"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ProxyRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Proxy and the relating Proxy shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ProxyRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193215_39216_23797"/>
               <specification xmi:id="_18_4_1_271a0567_1509116556923_339389_31536"
                              xmi:uuid="d549a24e-816c-476c-9a8d-196113b5ac75"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
