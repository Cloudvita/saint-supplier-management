               <ownedComment xmi:id="_18_4_1_65b021e_1671209121217_449940_163016"
                             xmi:uuid="5c1e0780-dabd-4485-831b-c6c149256521"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121218_717337_163017"
                                xmi:uuid="a9dc467f-ab27-4e66-a6ef-c7319b26a989"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//PartViewRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related PartView and the relating PartView shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:PartViewRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459330540376_251962_42659"
                             xmi:uuid="bf3bd147-e397-4854-9bb1-3f2184ce5597"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330499502_257959_42657"/>
                  <body>the related PartView and the relating PartView shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121218_927167_163018"
                             xmi:uuid="d12c72fc-98ed-4abe-8d8f-b11808b380bc"
