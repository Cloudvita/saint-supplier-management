         <packagedElement xmi:id="_18_4_1_65b021e_1719937007183_303628_147577"
                          xmi:uuid="8de98fdc-a62c-410f-a819-a2ef9656e0bf"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">RelationshipObjectRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_65b021e_1719937007213_901246_147581"
                       xmi:uuid="06b839e3-80f4-4293-b5bf-b21495b1b6a0"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1721730196870_99048_153319"
                             xmi:uuid="503e8842-adf6-4587-8325-82d9f4821750"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721730196871_646772_153320"
                                xmi:uuid="5ed9e378-50e6-49d0-9a4b-29fbc261f202"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//RelationshipObjectRelationship[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relating_type" value="if(../@xsi:type) then substring-after(../@xsi:type,':') else ../name()"/&gt; &lt;sch:let name="reference_uidRef" value="Related/@uidRef"/&gt; &lt;sch:let name="reference" value="//*[@uid = $reference_uidRef]"/&gt; &lt;sch:let name="related_type" value="if($reference/@xsi:type) then substring-after($reference/@xsi:type,':') else $reference/name()"/&gt; &lt;sch:assert test="$relating_type = $related_type"&gt; The Related and the Relating object shall be of same type. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -relating_type:&lt;sch:value-of select="$relating_type"/&gt; -related_type:&lt;sch:value-of select="$related_type"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1719937008060_460692_147677"
                             xmi:uuid="726b608e-752b-4708-b895-6f56d60bb6bc"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1719937008091_271585_147836"
                                xmi:uuid="c2592e88-bcca-4436-9a7f-ff20c57b9c78"
                                xmi:type="uml:Comment">
                     <body>WR1: TYPEOF(Relating) = TYPEOF(Related);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1719937008060_841523_147676"
                             xmi:uuid="e2b3e5b5-b5be-41f5-855b-9bc25bfd524c"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_65b021e_1719937007213_901246_147581"/>
                  <body>the related and the relating object shall be of same type.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_65b021e_1719937007183_303628_147577"/>
               <specification xmi:id="_18_4_1_65b021e_1719937008059_679320_147675"
                              xmi:uuid="9be4e75c-c868-40e5-9057-af7ec3ba3743"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating.oclType() = self.Related.oclType()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
