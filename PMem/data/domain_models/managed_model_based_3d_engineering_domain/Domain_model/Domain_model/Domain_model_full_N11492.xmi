                          xmi:uuid="6128b5ae-351e-4d80-8f9c-72baf31166ff"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">File</name>
            <isAbstract xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                        xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">true</isAbstract>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_8db01ea_1551105421277_634998_109282"
                       xmi:uuid="0d9d19f2-dc0d-45c9-97f5-387f9d223f4b"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_8db01ea_1551105459487_909073_109284"
                             xmi:uuid="156dc4a5-8873-4089-9e61-9cdb0980b216"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_8db01ea_1551105421277_634998_109282"/>
                  <body>Either Locations or FileLocations shall be defined </body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1721295759837_988077_151360"
                             xmi:uuid="7bd619f4-52ae-422d-93f6-749583e154e6"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721295759837_471800_151361"
                                xmi:uuid="4fc02cd0-ec1f-46d6-8ea0-4ed46ec1cecb"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//File[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="(Locations and not(FileLocations)) or (not(Locations) and FileLocations)"&gt; Either Locations or FileLocations shall be defined. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193104_196478_23578"/>
               <specification xmi:id="_18_4_1_8db01ea_1551105421277_153316_109283"
                              xmi:uuid="51e27484-67a7-47d6-84d3-3a633f793404"
                              xmi:type="uml:OpaqueExpression">
                  <body>not(self.Locations.oclIsUndefined()) xor not(self.FileLocations.oclIsUndefined())</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
