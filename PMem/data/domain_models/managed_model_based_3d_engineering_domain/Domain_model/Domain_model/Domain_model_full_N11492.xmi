                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">EventRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_271a0567_1509113672258_843511_31163"
                       xmi:uuid="483812b5-ab4c-4b96-ace1-edd22e39e817"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121432_815647_163080"
                             xmi:uuid="2444c0ec-d2f6-49b1-a3d6-afdda32ffeb8"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121433_500258_163081"
                                xmi:uuid="8f385986-2415-4b7f-9f8a-ebad5cd3929b"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//EventRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Event and the relating Event shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:EventRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_271a0567_1509113753671_778154_31172"
                             xmi:uuid="334710c8-49eb-493c-886b-d82526a57874"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_271a0567_1509113672258_843511_31163"/>
                  <body>the related Event and the relating Event shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121433_994297_163082"
                             xmi:uuid="9956734b-1c9b-4f39-928d-22519c3ad2ee"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121433_600976_163083"
                                xmi:uuid="b550020d-10e7-4543-b888-b9cc79892c27"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193092_483424_23548"/>
               <specification xmi:id="_18_4_1_271a0567_1509113672258_853936_31164"
                              xmi:uuid="658ea1e6-981e-4d57-b154-38e1e6bb8bfc"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
