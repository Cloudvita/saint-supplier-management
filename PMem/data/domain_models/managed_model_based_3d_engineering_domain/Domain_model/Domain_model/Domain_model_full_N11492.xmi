         <packagedElement xmi:id="_18_4_1_e120334_1499417193042_993124_23448"
                          xmi:uuid="dd2c886d-d850-4c87-b720-c272e8af4729"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ClassificationRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_271a0567_1509112607751_275016_30861"
                       xmi:uuid="2456ad56-3b3d-42e5-9d06-335bab4ea8fa"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121417_653241_163066"
                             xmi:uuid="36aa7880-e0f9-444b-b532-2e2fcdaaf604"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121418_717696_163067"
                                xmi:uuid="c4661271-daeb-4873-be78-f8dab59c8058"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_271a0567_1509112657228_78144_30870"
                             xmi:uuid="547f0e58-d1a0-46b9-8bab-a9e3a56d54a5"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_271a0567_1509112607751_275016_30861"/>
                  <body>the related Classification and the relating Classification shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121417_572016_163064"
                             xmi:uuid="d629a79e-3a2a-4385-83b6-a23120eef863"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121417_29789_163065"
                                xmi:uuid="7878e64b-56cd-42ce-a270-039778b5ce4b"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ClassificationRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Classification and the relating Classification shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ClassificationRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193042_993124_23448"/>
               <specification xmi:id="_18_4_1_271a0567_1509112607751_42329_30862"
                              xmi:uuid="a4aa3ca3-55a6-4b62-81bf-0e19d109da0e"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_e120334_1499417193490_649291_25422"
