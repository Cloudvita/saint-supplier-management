         <packagedElement xmi:id="_18_4_1_e120334_1499417193068_312072_23513"
                          xmi:uuid="9264763a-6228-4731-97f5-be5d744741c9"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">DescriptorRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459327338931_162689_42541"
                       xmi:uuid="73f57d08-2051-4d6a-a062-64081c1e81e0"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121458_212005_163088"
                             xmi:uuid="3d0f9933-03df-4b27-9be1-da1bfa0c8ef4"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121459_171410_163089"
                                xmi:uuid="cebfe0e2-e8bc-480a-ad1d-c59873f90338"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//DescriptorRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Descriptor and the relating Descriptor shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:DescriptorRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459327378360_651085_42543"
                             xmi:uuid="c58e1909-d9d5-46c7-9334-27c2b709eca5"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459327338931_162689_42541"/>
                  <body>the related Descriptor and the relating Descriptor shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121459_779895_163090"
                             xmi:uuid="d4c63120-8d10-43aa-82e9-05efd80c9bee"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121459_877909_163091"
                                xmi:uuid="bf6d72f6-a84e-4a8a-90d5-d2dff06dd18c"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193068_312072_23513"/>
               <specification xmi:id="_18_4_1_271a0567_1509113262869_685177_31099"
                              xmi:uuid="f1b393ea-36d6-4f01-9ca6-759dc45ccfda"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_e120334_1499417193577_62462_26106"
                            xmi:uuid="0441f8ce-1b65-4b8a-a15a-87241e4f7a84"
                            xmi:type="uml:Generalization">
