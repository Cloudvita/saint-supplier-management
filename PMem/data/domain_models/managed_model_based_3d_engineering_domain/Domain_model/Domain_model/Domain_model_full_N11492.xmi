         <packagedElement xmi:id="_19_0_4_b1702d9_1702993887082_62150_60050"
                          xmi:uuid="e68b8616-bd8d-4e80-aae4-8dd8e2fdbaf8"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">AlternatePartVersionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_b1702d9_1702993887083_863682_60051"
                       xmi:uuid="973e40f1-0954-4a49-8813-d45867c0b9c8"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_b1702d9_1702993887605_526783_60189"
                             xmi:uuid="379c1cfb-8597-4329-99fd-da12621c136e"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_19_0_4_b1702d9_1702993887631_537982_60376"
                                xmi:uuid="74b1a18a-2a62-4058-a8d9-ea2568f1bda0"
                                xmi:type="uml:Comment">
                     <body>UR1: SELF\PartVersionRelationship.Relating, SELF\PartVersionRelationship.Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1721295758553_474305_151280"
                             xmi:uuid="4b10fd99-2c4d-46e6-a096-21f0eb66e6d8"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721295758553_808308_151281"
                                xmi:uuid="996ff59c-9e43-4db9-9fad-df69e0b375a9"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='AlternatePartVersionRelationship']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatingUid" value="../@uid"/&gt; &lt;sch:let name="relatedUid" value="Related/@uidRef"/&gt; &lt;sch:assert test="not(//*[@uid and substring-after(@xsi:type,':')='AlternatePartVersionRelationship' and ../@uid = $relatingUid and Related/@uidRef = $relatedUid and @uid != $uid])"&gt; The combination of the related part version and the relating part version shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:RelatingAndRelatedUids -attribute_value:&lt;sch:value-of select="concat($relatingUid, ',', $relatedUid)"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_19_0_4_b1702d9_1702993887605_530618_60188"
                             xmi:uuid="b8c9c41e-20f0-4302-8ac2-8aead95921a8"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702993887083_863682_60051"/>
                  <body>the combination of the related part version and the relating part version shall be unique. </body>
               </ownedComment>
               <name>UR1</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702993887082_62150_60050"/>
               <specification xmi:id="_19_0_4_b1702d9_1702993887605_24441_60187"
                              xmi:uuid="e0f6b16f-0d3f-4924-9291-078e1083eb7b"
                              xmi:type="uml:OpaqueExpression">
                  <body>AlternatePartVersionRelationship::allInstances() -&gt;isUnique(Sequence{Relating, Related})</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
