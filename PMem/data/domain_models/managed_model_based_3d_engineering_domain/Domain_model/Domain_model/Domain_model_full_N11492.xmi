            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459328383656_343264_42567"
                       xmi:uuid="9c22daea-0c01-4218-be99-624e1bbea167"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1714997368185_942202_151614"
                             xmi:uuid="0733a2a3-8ee1-46e0-b374-c1fb656e7025"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714997368185_57697_151615"
                                xmi:uuid="e9a70d2d-4708-4c45-b8f6-cb911e6e16ed"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='FilamentLaminate' ]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="stockMaterialRef" value="MadeFrom/@uidRef"&gt;&lt;/sch:let&gt; &lt;sch:assert test="//*[@uid=$stockMaterialRef]/StockMaterialType eq 'filament_assembly'"&gt;(FilamentLaminate.WR1 &lt;sch:value-of select="$uid"/&gt;) the stock material shall be of type filament assembly.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459328425973_868191_42569"
                             xmi:uuid="a2f5e4e3-8f5d-4d1e-9a77-fa811b25fd22"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459328383656_343264_42567"/>
                  <body> the stock material shall be of type filament assembly.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671446868885_551611_162955"
                             xmi:uuid="f0bb36f8-fd2a-4539-a5c8-1cc487328eba"
                             xmi:type="uml:Comment">
