            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ActivityMethodRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_271a0567_1508923029894_282009_28578"
                       xmi:uuid="849f1058-bc5f-4266-a1ce-7016b170187d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_271a0567_1508932608557_601994_30813"
                             xmi:uuid="1f30d458-fd6b-498e-bddc-ff0826ef23ea"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_271a0567_1508923029894_282009_28578"/>
                  <body>the related ActivityMethod and the relating ActivityMethod shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121529_518103_163100"
                             xmi:uuid="46cb0fdc-63e7-41f6-b55e-0cfcd9b6ce37"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121529_379374_163101"
                                xmi:uuid="f435fc67-edb6-42c7-a463-a3efbb3bd920"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ActivityMethodRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related ActivityMethod and the relating ActivityMethod shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ActivityMethodRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121529_236684_163102"
                             xmi:uuid="6295fd31-0f0e-421d-8086-0e5e144e09b1"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121529_712719_163103"
                                xmi:uuid="71b044ae-2ad8-47dc-a3b6-df25a5582b07"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193013_938170_23379"/>
               <specification xmi:id="_18_4_1_271a0567_1508923029896_771367_28579"
                              xmi:uuid="3f144f36-8dcc-4574-b51f-83188d780946"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
