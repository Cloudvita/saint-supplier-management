         <packagedElement xmi:id="_18_4_1_e120334_1499417193223_252090_23812"
                          xmi:uuid="39e7e5c3-f057-40ba-8f7e-4a504e190b2f"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">GeometryToTopologyModelAssociation</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_45e01bd_1597350572812_165263_88452"
                       xmi:uuid="a37e5ea9-655b-4ce2-af60-bfe82686f0cf"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671446987046_301100_162975"
                             xmi:uuid="7c8533de-b74e-45f1-9191-204535ada696"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671446993636_414702_162976"
                                xmi:uuid="e2a2ceff-9de5-4d13-b1dc-0398dca18d69"
                                xmi:type="uml:Comment">
                     <body>WR2: SIZEOF(QUERY( ac &lt;* AssemblyContext | NOT (SCHEMA_NAME + '.' + 'WiringHarnessAssemblyDesign' IN TYPEOF(ac\AssemblyOccurrenceRelationship.Relating)))) = 0;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_45e01bd_1597350597174_65074_88460"
                             xmi:uuid="c18ec16f-f872-4b28-86f4-326cd9992bf2"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_45e01bd_1597350572812_165263_88452"/>
                  <body>a GeometryToTopologyModelAssociation shall only be applied in a WiringHarnessAssemblyDesign.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943701_95890_151482"
                             xmi:uuid="df8cf47d-7575-460d-a211-f89c5cfa3eb6"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943701_551309_151483"
                                xmi:uuid="c77e880a-1ef7-4a37-9858-f4e44cdb06b6"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometryToTopologyModelAssociation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="assemblyContext" value="//*[@uid and local-fn:testXsiTypeAssemblyOccurrenceRelationship(@xsi:type)=true() and child::Placement/child::GeometryToTopologyModelAssociation/@uidRef = $uid]"/&gt; &lt;sch:assert test="count($assemblyContext)=0 or (every $i in $assemblyContext satisfies substring-after($i/parent::*/@xsi:type,':')='WiringHarnessAssemblyDesign')"&gt;(GeometryToTopologyModelAssociation.WR2 &lt;sch:value-of select="$uid"/&gt;) a GeometryToTopologyModelAssociation shall only be applied in a WiringHarnessAssemblyDesign.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR2</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193223_252090_23812"/>
               <specification xmi:id="_18_4_1_45e01bd_1597350572816_927094_88453"
                              xmi:uuid="e3db5391-ed3d-4379-8a96-8664331b2b96"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.AssemblyContext-&gt;reject(ac | ac.Relating.oclIsKindOf(Application_protocols::AP242::Domain_model::ElectricalHarness::WiringHarnessAssemblyDesign))-&gt;size() = 0</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_45e01bd_1597350610472_897322_88463"
                       xmi:uuid="ce3abdc2-9976-49a9-935d-84515240694d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_45e01bd_1597350633670_73967_88471"
                             xmi:uuid="5ab46a72-84e5-4d45-acef-51863f99fd6c"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_45e01bd_1597350610472_897322_88463"/>
                  <body>a GeometryToTopologyModelAssociation shall not be definitional</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671447048086_391663_162979"
                             xmi:uuid="a3ed28d8-e7d5-4699-9460-3ac8bfc10d53"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671447054339_344687_162980"
                                xmi:uuid="50a6f032-87a2-45d2-8449-33f30121ee41"
                                xmi:type="uml:Comment">
                     <body>WR3: SELF\RepresentationRelationship.Definitional = FALSE;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943708_310989_151484"
                             xmi:uuid="aac7c328-ea54-4647-970a-271a1993adcb"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943708_64450_151485"
                                xmi:uuid="b7421b59-ab43-4178-8ad9-563c6fde89e9"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometryToTopologyModelAssociation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="child::Definitional='false'"&gt;(GeometryToTopologyModelAssociation.WR3 &lt;sch:value-of select="$uid"/&gt;) a GeometryToTopologyModelAssociation shall not be definitional.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR3</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193223_252090_23812"/>
               <specification xmi:id="_18_4_1_45e01bd_1597350610472_233832_88464"
                              xmi:uuid="d27c6253-d6a2-406a-aed9-1d6f123b9a0c"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Definitional = DataTypes::Boolean::False</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_8db01ea_1590411292840_414618_94191"
                       xmi:uuid="f74454af-3a47-4646-9adf-b429cd425400"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943718_400076_151486"
                             xmi:uuid="65affb58-225b-460f-8b65-1d0d4be6065d"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943718_873106_151487"
                                xmi:uuid="601a495f-01d2-48f3-9a61-8efb1c138648"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometryToTopologyModelAssociation']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="count(child::Target/child::*) = count(child::Origin/child::*)"&gt;(GeometryToTopologyModelAssociation.WR1 &lt;sch:value-of select="$uid"/&gt;) the size of Target list shall be the same as the size of the Origin list.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_8db01ea_1590411292844_174829_94193"
                             xmi:uuid="9cc34371-94d6-4257-8e81-6dd187d32b29"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_8db01ea_1590411292840_414618_94191"/>
                  <body>the size of Target list shall be the same as the size of the Origin list.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671446970980_411491_162969"
                             xmi:uuid="dbe4128e-f597-41bb-9bae-ac68d1ebf93a"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671446980081_182183_162972"
                                xmi:uuid="f75c01c5-1f31-4859-9f3b-8f959ff19be7"
                                xmi:type="uml:Comment">
                     <body>WR1: SIZEOF(Origin) = SIZEOF(Target);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193223_252090_23812"/>
               <specification xmi:id="_18_4_1_8db01ea_1590411292844_278547_94192"
                              xmi:uuid="ed1a41ef-b4ee-4af1-bfab-14f67fc5f291"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Origin-&gt;size() = self.Target-&gt;size()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
