         <packagedElement xmi:id="_18_4_1_e120334_1499417193193_492702_23766"
                          xmi:uuid="da113b90-9de6-4908-bbe7-679ffbe3ef35"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ProcessPlanRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459331077251_874034_42685"
                       xmi:uuid="d6bc036e-83e8-4550-93cb-48496b16d49e"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459331111289_25857_42687"
                             xmi:uuid="3ccc16a6-685a-46bb-8b2a-4b20caa84c71"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331077251_874034_42685"/>
                  <body>the related ProcessPlan and the relating ProcessPlan shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121873_702620_163150"
                             xmi:uuid="554a092f-2678-4344-8970-b751124c9d87"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121873_264953_163151"
                                xmi:uuid="1538f91d-0f68-43a2-bb11-f88f3b92c938"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121873_161358_163148"
                             xmi:uuid="fe59ec35-f9e9-4b61-9500-fdd762b52637"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121873_254544_163149"
                                xmi:uuid="129c0558-6b21-4fcb-ae1d-89edd1b3bc98"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ProcessPlanRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related ProcessPlan and the relating ProcessPlan shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ProcessPlanRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193193_492702_23766"/>
               <specification xmi:id="_18_4_1_271a0567_1509116031418_749748_31423"
                              xmi:uuid="e4a80e52-799e-4985-8b30-d7f1e42783ae"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
