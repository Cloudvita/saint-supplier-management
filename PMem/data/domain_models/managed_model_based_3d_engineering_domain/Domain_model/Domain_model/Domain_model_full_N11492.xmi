         <packagedElement xmi:id="_18_4_1_e120334_1499417193232_160856_23825"
                          xmi:uuid="d1816c17-49d8-4928-96c1-9125b5cf7e2b"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">RequirementVersionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459332121656_409756_42721"
                       xmi:uuid="890beb56-8607-428b-85cc-4f32d952637d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121252_263564_163028"
                             xmi:uuid="3d16e86a-5e9f-4a08-81ed-bea93b1a0ecb"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121252_290365_163029"
                                xmi:uuid="af72a8a9-dce9-418f-b839-d541e8410130"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//RequirementVersionRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related RequirementVersion and the relating RequirementVersion shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:RequirementVersionRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121252_795859_163030"
                             xmi:uuid="d64dc499-8bd9-4022-a79e-aca9b9769bbc"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121253_632201_163031"
                                xmi:uuid="3ebd05a5-7220-41fa-a924-d0601eefe61f"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459332150522_39676_42723"
                             xmi:uuid="d8f6d574-64b6-4057-8a00-4026f419a841"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332121656_409756_42721"/>
                  <body>the related RequirementVersion and the relating RequirementVersion shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193232_160856_23825"/>
               <specification xmi:id="_18_4_1_271a0567_1509116697627_496769_31560"
                              xmi:uuid="f3db1dc3-e805-4d33-b0a5-5ce97cb85b44"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
