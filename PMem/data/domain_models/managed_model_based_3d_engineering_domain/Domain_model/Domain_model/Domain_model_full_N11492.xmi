                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">PropertyDefinitionAssignmentRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459331528511_306328_42700"
                       xmi:uuid="f2e577ce-894b-4942-af77-88ae9d58f81d"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121358_220452_163052"
                             xmi:uuid="700142ad-3cc8-47c3-8fa9-f1dfed1da357"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121359_795637_163053"
                                xmi:uuid="3c1b0441-6974-48fa-82ae-81bb598eb55f"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//PropertyDefinitionAssignmentRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related PropertyDefinitionAssignment and the relating PropertyDefinitionAssignment shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:PropertyDefinitionAssignmentRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459331561149_263298_42702"
                             xmi:uuid="b757d8e0-e917-4d1c-9f3c-ce898b1f0939"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331528511_306328_42700"/>
                  <body>the related PropertyDefinitionAssignment and the relating PropertyDefinitionAssignment shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121359_621884_163054"
                             xmi:uuid="bb0000b3-f42e-4bf4-97ab-612a70524a52"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121359_778552_163055"
                                xmi:uuid="c294083c-be81-41ad-9727-0c2c12d18db0"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193208_443452_23786"/>
               <specification xmi:id="_18_4_1_271a0567_1509116339684_969956_31480"
                              xmi:uuid="9ea232f9-96cf-4555-a890-1f5be07eabd8"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
