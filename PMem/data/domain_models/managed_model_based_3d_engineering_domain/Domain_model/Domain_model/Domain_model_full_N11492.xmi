         <packagedElement xmi:id="_18_4_1_e120334_1499417193035_131604_23437"
                          xmi:uuid="491e272b-7962-4588-9327-c4f3f1ef0247"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">CartesianTransformation</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_290014c_1527250283753_707278_68694"
                       xmi:uuid="11e9c70f-3d7c-4f3d-8775-da5983743177"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_290014c_1527250283760_887132_68696"
                             xmi:uuid="35fc88a1-0096-4add-b642-b48791c14a23"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_290014c_1527250283753_707278_68694"/>
                  <body>The RotationMatrix shall not be used for shearing.</body>
               </ownedComment>
               <name>IP1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193035_131604_23437"/>
               <specification xmi:id="_18_4_1_290014c_1527250283760_914840_68695"
                              xmi:uuid="726f4d3e-866c-4343-8b04-aa6c8bb86efa"
                              xmi:type="uml:OpaqueExpression">
                  <body>The RotationMatrix shall not be used for shearing.</body>
                  <language>English</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459326281015_438682_42513"
                       xmi:uuid="25d48b11-5e47-4373-a58f-19fc33b2a8f2"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459326320125_402182_42515"
                             xmi:uuid="0cde679a-233c-4b48-a628-e3f51b524bcf"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326281015_438682_42513"/>
                  <body>the value of Scale shall be greater than zero.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943824_91841_151512"
                             xmi:uuid="83bacdf0-6ce9-4764-ba97-1225e79bb8a7"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943825_801929_151513"
                                xmi:uuid="b697c1d8-9ffe-4a2d-ad81-735f4f75ba29"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//CartesianTransformation[@uid] | //RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']/child::Transformation[@uid] "&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(Scale) or (number(Scale) gt 0.0) "&gt;(CartesianTransformation.WR2 &lt;sch:value-of select="$uid"/&gt;) the value of Scale shall be greater than zero. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671446551523_228290_162923"
                             xmi:uuid="e459fe32-192c-477a-bf54-d9ee64fa2972"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671446558728_646613_162924"
                                xmi:uuid="997a1bcc-5ee7-427b-bb10-940c5d9d5657"
                                xmi:type="uml:Comment">
                     <body>WR2: Scale &gt; 0.0;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR2</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193035_131604_23437"/>
               <specification xmi:id="_18_4_1_271a0567_1509029121640_928598_30314"
                              xmi:uuid="e698bb00-5c54-4df2-a9eb-28434ae93b7b"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Scale &gt; 0</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_271a0567_1509029363774_484736_30342"
                       xmi:uuid="576b06d6-a390-41a0-b1a8-c5d796759904"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671446572397_295596_162927"
                             xmi:uuid="aba2841c-a783-42c7-9cf3-6a13442e42e4"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671446587408_681046_162930"
                                xmi:uuid="517ace3a-4969-4108-a6b0-19a8fd60668e"
                                xmi:type="uml:Comment">
                     <body>WR3: SIZEOF(TranslationVector) = SIZEOF(RotationMatrix);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_271a0567_1509029482650_819599_30359"
                             xmi:uuid="ec9aab27-9687-48be-b901-1958e3a8b531"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_271a0567_1509029363774_484736_30342"/>
                  <body>the dimensionality of the TranslationVector shall be the same as for the RotationMatrix.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943810_961389_151508"
                             xmi:uuid="f7095ae7-21c9-435d-abbb-ee1eaac8d57f"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943811_73340_151509"
                                xmi:uuid="a7c5aebc-0c7c-4595-8370-32c198d9e80f"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//CartesianTransformation[@uid] | //RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']/child::Transformation[@uid] "&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="count(tokenize(normalize-space(RotationMatrix), ' '))=9 and count(tokenize(normalize-space(TranslationVector), ' '))=3 or count(tokenize(normalize-space(RotationMatrix), ' '))=4 and count(tokenize(normalize-space(TranslationVector), ' '))=2" &gt;(CartesianTransformation.WR3 &lt;sch:value-of select="$uid"/&gt;) the dimensionality of the TranslationVector shall be the same as for the RotationMatrix.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR3</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193035_131604_23437"/>
               <specification xmi:id="_18_4_1_271a0567_1509029363775_534292_30343"
                              xmi:uuid="98008e8a-20b7-438b-b389-b7628b54e311"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.TranslationVector-&gt;size() = self.RotationMatrix-&gt;size()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459326229485_925634_42510"
                       xmi:uuid="cd4d01ec-4e93-44be-9424-2496bf91a177"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459326264463_233471_42512"
                             xmi:uuid="23a7c742-8362-403e-a47e-baa0e0b39c25"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326229485_925634_42510"/>
                  <body>the values of the RotationMatrix shall be in the interval [-1.0,+1.0]</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943832_595814_151514"
                             xmi:uuid="5c9ea0c1-26b2-4bca-9894-5e34ad969684"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943832_24132_151515"
                                xmi:uuid="47ad502d-a26b-4eac-b17b-d1db48758a8d"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//CartesianTransformation[@uid] | //RepresentationRelationship[@uid and substring-after(@xsi:type,':')='GeometricRepresentationRelationshipWithCartesianTransformation']/child::Transformation[@uid] "&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="every $i in tokenize(normalize-space(RotationMatrix), ' ') satisfies (number($i) ge -1 and number($i) le 1) "&gt;(CartesianTransformation.WR1 &lt;sch:value-of select="$uid"/&gt;) the values of the RotationMatrix shall be in the interval [-1.0,+1.0]. &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671446491418_729658_162919"
                             xmi:uuid="be2e423b-af77-411a-a991-01238abbdc17"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671446500307_597367_162920"
                                xmi:uuid="b81c4c33-06f8-439c-970c-fbf37ad8d8a4"
                                xmi:type="uml:Comment">
                     <body>WR1: SIZEOF( QUERY(xi &lt;* RotationMatrix | SIZEOF( QUERY(xj &lt;* xi | (-1.0 &gt; xj) OR (xj &gt; 1.0))) &gt; 0)) = 0;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193035_131604_23437"/>
               <specification xmi:id="_18_4_1_271a0567_1509712902795_523600_29369"
                              xmi:uuid="3c4c1f89-ca22-46fc-aa4a-9b77935404bf"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.RotationMatrix-&gt;forAll(lr | lr.elements-&gt;forAll(e | (e &gt;= -1.0) and (e &lt;= 1.0) ))</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_e120334_1499417193401_178790_24810"
