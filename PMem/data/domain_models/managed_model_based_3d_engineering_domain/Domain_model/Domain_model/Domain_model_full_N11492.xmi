            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">BreakdownElementVersionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459325951507_336988_42488"
                       xmi:uuid="60caf533-c9e1-4871-81a4-26287294b200"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459325987691_621238_42490"
                             xmi:uuid="7eaa67ac-31c2-4df3-a504-0b6cda31c0ad"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325951507_336988_42488"/>
                  <body>the related BreakdownElementVersion and the relating BreakdownElementVersion shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121899_102375_163170"
                             xmi:uuid="9e17ced0-04b1-478c-9573-ffdb5da11137"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121899_547007_163171"
                                xmi:uuid="f7775d28-c855-4236-a49d-c14abc558e1b"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121898_544175_163168"
                             xmi:uuid="e6bc3fa5-518a-4a57-bcd1-65b260cbf25a"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121898_118065_163169"
                                xmi:uuid="43293d15-f2a6-4963-9fe2-d92c932850e4"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//BreakdownElementVersionRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related BreakdownElementVersion and the relating BreakdownElementVersion shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:BreakdownElementVersionRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193029_140190_23425"/>
               <specification xmi:id="_18_4_1_271a0567_1509111855640_155640_30509"
                              xmi:uuid="4c001c29-606e-406b-a684-ca70342b40ae"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
