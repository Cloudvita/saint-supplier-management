                          xmi:uuid="31febb29-56b8-45d4-88d3-76a604e8313d"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_4_1_91401df_1697110650389_550882_146695"
                             xmi:uuid="daef323a-3680-4023-a685-aab17d14a64e"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_91401df_1697110382241_403522_146691"/>
                  <body>the specification applies to all surfaces for which no other tolerance of the same type is defined. &lt;note&gt; The use of "unless otherwise specified" is described in ASME Y14.5.&lt;/note&gt;</body>
               </ownedComment>
               <name>unless_otherwise_specified</name>
            </ownedLiteral>
         </packagedElement>
         <packagedElement xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                          xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                          xmi:id="_18_4_1_91401df_1606832333405_781570_91030"
                          xmi:uuid="b39a18de-3c46-4b6e-9f3b-6e83e5ab7fb0"
                          xmi:type="uml:Enumeration">
            <ownedComment xmi:id="_18_4_1_91401df_1614264930183_229829_91315"
                          xmi:uuid="a90abf63-e4e5-44ad-9d54-ca2f9d53d0ae"
                          xmi:type="uml:Comment">
               <annotatedElement xmi:idref="_18_4_1_91401df_1606832333405_781570_91030"/>
               <body>The PassFilterEnum is a list of alternate data types that allows for the designation of the pass filter in accordance with ISO 1101 unless otherwise specified;</body>
            </ownedComment>
            <name>PassFilterEnum</name>
            <ownedLiteral xmi:id="_18_4_1_91401df_1606833018433_291119_91053"
                          xmi:uuid="59e36bff-4856-478b-8164-985f0a0363b8"
                          xmi:type="uml:EnumerationLiteral">
               <ownedComment xmi:id="_18_4_1_91401df_1608137288098_766810_90590"
                             xmi:uuid="a39678f3-3e05-4bfc-96d9-5380319a4ac2"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_91401df_1606833018433_291119_91053"/>
                  <body>indicates that long wave pass filter applies in accordance with ISO 1101 unless otherwise specified.</body>
               </ownedComment>
               <name>long_wave_pass_filter</name>
            </ownedLiteral>
            <ownedLiteral xmi:id="_18_4_1_91401df_1606833047373_781452_91055"
                          xmi:uuid="b3de44bd-a993-4bf1-9472-e577fd0e8d16"
                          xmi:type="uml:EnumerationLiteral">
