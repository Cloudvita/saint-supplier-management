                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ModifySingleElement</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459330097504_637935_42639"
                       xmi:uuid="5ce92a0d-25ef-41b9-932f-727899971bd3"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671456236591_782922_163055"
                             xmi:uuid="936d20df-3aab-4ad2-9d2e-02ce097e63f6"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671456243844_314580_163056"
                                xmi:uuid="597a51e2-19f0-4469-ada2-3e85d295eb90"
                                xmi:type="uml:Comment">
                     <body>WR1: CurrentDesignObject :&lt;&gt;: PreviousDesignObject;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459330144365_221463_42641"
                             xmi:uuid="960e6a08-412f-476c-89ba-becda43f85c2"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330097504_637935_42639"/>
                  <body> the PreviousDesignObject and CurrentDesignObject shall refer to different objects.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1721295760088_656091_151366"
                             xmi:uuid="ab028dcc-cf4d-49f9-9af7-068ca32a4c40"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721295760088_702340_151367"
                                xmi:uuid="851e0f6d-897b-4e15-8c1b-0ac11ab8e6c7"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='ModifySingleElement']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(PreviousDesignObject/@uidRef = CurrentDesignObject/@uidRef)"&gt; The PreviousDesignObject and CurrentDesignObject shall refer to different objects. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193150_611193_23670"/>
               <specification xmi:id="_18_4_1_271a0567_1509095053076_154196_30357"
                              xmi:uuid="2a4dda14-1080-4cb6-847c-bcde6765c1c7"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.CurrentDesignObject &lt;&gt; self.PreviousDesignObject</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_e120334_1499417193573_206552_26065"
