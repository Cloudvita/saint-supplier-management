                          xmi:uuid="75717cd3-2a02-46c1-8077-9df694fd8139"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ProcessOperationDefinitionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459330933271_629283_42674"
                       xmi:uuid="ea166b2a-af47-4042-a619-a3b976351a3a"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459330975721_209720_42676"
                             xmi:uuid="47d61b1e-6c06-48d9-85ae-960d5c789090"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459330933271_629283_42674"/>
                  <body>the related ProcessOperationDefinition and the relating ProcessOperationDefinition shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121883_246889_163158"
                             xmi:uuid="b4407594-746e-484e-8375-950d640977df"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121883_891851_163159"
                                xmi:uuid="113bb78d-1411-4dd7-a27a-e3be22b5ab36"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121882_20064_163156"
                             xmi:uuid="e7018b2e-1d00-49e8-a2c1-6821ed5040db"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121882_580537_163157"
                                xmi:uuid="435bb038-b8ee-445b-99cc-5497d647aa27"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ProcessOperationDefinitionRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related ProcessOperationDefinition and the relating ProcessOperationDefinition shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ProcessOperationDefinitionRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193188_761378_23758"/>
               <specification xmi:id="_18_4_1_271a0567_1509115942976_884896_31397"
                              xmi:uuid="7597a24d-3721-4139-9909-1060b92cfdcf"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
