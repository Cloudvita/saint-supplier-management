         <packagedElement xmi:id="_18_4_1_e120334_1499417193038_103118_23445"
                          xmi:uuid="909353aa-ca3f-442e-a977-37ef19cce9c8"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">Class</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_e120334_1499417193461_670349_25250"
                       xmi:uuid="8a9a15f0-7628-4d7c-a721-1a9c3e5ce0c1"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1721295759263_726027_151322"
                             xmi:uuid="3575934f-fa56-4c74-becb-275390e83766"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721295759264_841722_151323"
                                xmi:uuid="9a150688-aabe-48ab-88c5-45cfba41b1d3"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//Class[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="ids" value="child::Id/@id union child::Id/descendant::*[self::Identifier]/@id"/&gt; &lt;sch:let name="followingAndPrecedingIds" value="following-sibling::Class/Id/@id union following-sibling::Class/Id/descendant::*[self::Identifier]/@id union preceding-sibling::Class/Id/@id union preceding-sibling::Class/Id/descendant::*[self::Identifier]/@id"/&gt; &lt;sch:assert test="count($ids) = 0 or not(some $i in $ids, $j in $followingAndPrecedingIds satisfies ($i eq $j))"&gt; The Id shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:Id -attribute_value:&lt;sch:value-of select="$ids"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_45e01bd_1513341822093_153812_93617"
                             xmi:uuid="b7b8de29-4953-48d1-b6d7-6867e1727afe"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417193461_670349_25250"/>
                  <body>the Id shall be unique.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671465059967_341400_163124"
                             xmi:uuid="db03dc48-b409-43f3-ad49-0e6aed104c83"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671465067789_394980_163125"
                                xmi:uuid="852d75ff-8bb8-489b-8637-0330e68d529e"
                                xmi:type="uml:Comment">
                     <body>UR1: Id;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>UR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193038_103118_23445"/>
               <specification xmi:id="_18_4_1_e120334_1499417194282_334222_30563"
                              xmi:uuid="567c0b14-3d05-4d8b-9c75-b0d5c4abb97e"
                              xmi:type="uml:OpaqueExpression">
                  <body>Class::allInstances()-&gt;isUnique(Id)</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
