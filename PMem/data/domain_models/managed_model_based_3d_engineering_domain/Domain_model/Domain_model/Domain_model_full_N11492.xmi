         <packagedElement xmi:id="_18_4_1_e120334_1499417193259_743259_23866"
                          xmi:uuid="1fd0747e-202c-4579-8903-4f255bc7b7f6"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">SuppliedObjectRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459332374174_217157_42733"
                       xmi:uuid="e6434213-82c0-4675-bafa-d181f6d10f3f"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671462045344_771166_163079"
                             xmi:uuid="1f10a3af-0292-45c6-8c30-1e1eb7dc3cac"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671462052892_688583_163080"
                                xmi:uuid="37387169-9edd-41f6-aa0b-13d26026930e"
                                xmi:type="uml:Comment">
                     <body>WR1: TYPEOF(Relating) = TYPEOF(Related);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459332412201_902243_42735"
                             xmi:uuid="6655d4a8-0757-4e2b-97ca-a3fc3d7ad56b"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332374174_217157_42733"/>
                  <body> the Related and the Relating object shall be of same type.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1721730196879_993696_153321"
                             xmi:uuid="a632ead7-89f1-48ab-b6ef-b7af72743c98"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721730196880_51026_153322"
                                xmi:uuid="91ea12b1-6fd3-4d5f-872e-d44be8dea306"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//SuppliedObjectRelationship[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relating_type" value="if(../@xsi:type) then substring-after(../@xsi:type,':') else ../name()"/&gt; &lt;sch:let name="reference_uidRef" value="Related/@uidRef"/&gt; &lt;sch:let name="reference" value="//*[@uid = $reference_uidRef]"/&gt; &lt;sch:let name="related_type" value="if($reference/@xsi:type) then substring-after($reference/@xsi:type,':') else $reference/name()"/&gt; &lt;sch:assert test="$relating_type = $related_type"&gt; The Related and the Relating object shall be of same type. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -relating_type:&lt;sch:value-of select="$relating_type"/&gt; -related_type:&lt;sch:value-of select="$related_type"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193259_743259_23866"/>
               <specification xmi:id="_18_4_1_271a0567_1510563417337_709494_29622"
                              xmi:uuid="43d68ac3-bc22-4add-9309-1d6aa41551cc"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating.oclType() = self.Related.oclType() </body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
