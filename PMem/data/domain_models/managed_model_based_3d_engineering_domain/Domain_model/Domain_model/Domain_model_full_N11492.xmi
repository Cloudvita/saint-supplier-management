            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">IndividualPartViewRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459329447745_912747_42608"
                       xmi:uuid="56310f57-d417-4da7-a6d9-1a6d5a836531"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121306_442256_163036"
                             xmi:uuid="398270a8-e70e-4cf1-8fd8-96572a0cdda4"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121307_139789_163037"
                                xmi:uuid="d61c3069-b8a3-4c07-9252-3c7f69be7af6"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//IndividualPartViewRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related IndividualPartView and the relating IndividualPartView shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:IndividualPartViewRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459329484177_685976_42610"
                             xmi:uuid="5afb8bce-793b-40e3-af3b-6dfeeb1ca0e6"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329447745_912747_42608"/>
                  <body>the related IndividualPartView and the relating IndividualPartView shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121307_587560_163038"
                             xmi:uuid="f046d2f6-459f-4e0f-b63a-cf3ba028569b"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121307_358968_163039"
                                xmi:uuid="b2ea5e27-cb0f-4a70-bab2-e7079aab2bb1"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193128_308383_23618"/>
               <specification xmi:id="_18_4_1_271a0567_1509114674915_862477_31269"
                              xmi:uuid="74a1262e-bdd7-4498-9ed0-6397a50fb196"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
