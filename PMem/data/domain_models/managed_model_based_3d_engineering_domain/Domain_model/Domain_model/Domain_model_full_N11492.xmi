         <packagedElement xmi:id="_18_4_1_e120334_1499417193052_628492_23470"
                          xmi:uuid="baf39346-bf38-4010-9bdd-cc9630573f7c"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ConditionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459326540220_982338_42522"
                       xmi:uuid="cf8ccf2c-5703-4866-88fd-4eeb36f5dff3"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121346_831174_163050"
                             xmi:uuid="50f336b8-a3f4-4ef7-91ff-5f7dc40eaa33"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121346_298037_163051"
                                xmi:uuid="bd93e9f8-cda1-4a7b-a304-1b07c92bfb3e"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459326583650_27779_42524"
                             xmi:uuid="9abb3be3-14bd-4d95-9089-db91150ee04d"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326540220_982338_42522"/>
                  <body>the related Condition and the relating Condition shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121345_840417_163048"
                             xmi:uuid="f11b4b45-a7a0-4b83-b716-a43a6a315fe1"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121346_720369_163049"
                                xmi:uuid="47279030-eac1-4733-b627-ab8d6d1744e0"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ConditionRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Condition and the relating Condition shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ConditionRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193052_628492_23470"/>
               <specification xmi:id="_18_4_1_271a0567_1509112549154_132397_30852"
                              xmi:uuid="49ff8d61-96eb-4a35-8a11-0ae297f908d3"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
