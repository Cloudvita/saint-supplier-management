            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459329290170_997248_42597"
                       xmi:uuid="e5c207c3-9872-4b53-be9c-1b91b01266bc"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121299_216572_163034"
                             xmi:uuid="169e98cc-91fb-4947-9a46-5ba2b6852d53"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121299_73897_163035"
                                xmi:uuid="7d446308-0a23-408e-82cd-16f35c8e0bd2"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121298_811827_163032"
                             xmi:uuid="c3821a99-3858-4ce2-9520-769005dc9ef7"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121299_410798_163033"
                                xmi:uuid="0422e0c1-75bc-4eec-b51b-40f5ae6935dc"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//IndividualPartRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related IndividualPart and the relating IndividualPart shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:IndividualPartRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459329321264_339755_42599"
                             xmi:uuid="d01e9f69-f466-4321-bb2d-ba637fdf9ca1"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329290170_997248_42597"/>
                  <body>the related IndividualPart and the relating IndividualPart shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193125_990056_23613"/>
               <specification xmi:id="_18_4_1_271a0567_1509114286249_939932_31237"
                              xmi:uuid="99f7b8b3-918c-46fb-8d34-bf2f64242bb6"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
