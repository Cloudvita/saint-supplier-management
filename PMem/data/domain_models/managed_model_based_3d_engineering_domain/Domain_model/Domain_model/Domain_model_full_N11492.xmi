               <ownedComment xmi:id="_18_4_1_65b021e_1671209121702_147808_163124"
                             xmi:uuid="a7a97db4-4537-4b51-a765-fb652cfa8069"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121703_838224_163125"
                                xmi:uuid="1f470e82-7d26-4553-ae7e-faf78c6ae7b0"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ProductClassRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related ProductClass and the relating ProductClass shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ProductClassRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459331364513_597471_42693"
                             xmi:uuid="faaf171c-e352-46b3-80e0-6d89fd12de32"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331331716_671582_42691"/>
                  <body>the related ProductClass and the relating ProductClass shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193195_739043_23769"/>
               <specification xmi:id="_18_4_1_271a0567_1509116099956_502715_31439"
                              xmi:uuid="22da7680-1e45-498e-a50c-d4187934db37"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
