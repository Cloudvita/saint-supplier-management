                                xmi:uuid="2a73f370-f79d-46d8-8cf6-d56a1ce669ba"
                                xmi:type="uml:Comment">
                     <body>WR1: SIZEOF(Origin) = SIZEOF(Target);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193114_970653_23596"/>
               <specification xmi:id="_18_4_1_271a0567_1551271605457_181129_94420"
                              xmi:uuid="6c8bcc59-3897-4d1a-8805-ffad76b11650"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Origin-&gt;size() = self.Target-&gt;size()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
