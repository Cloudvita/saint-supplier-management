            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">AlternatePartRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_e120334_1499417193354_89148_24382"
                       xmi:uuid="a50fb079-1bfc-40e9-99ff-6056a29afd3b"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1721295758595_671230_151284"
                             xmi:uuid="9a8dc433-e09f-4358-b8f2-443950b52b41"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721295758595_903236_151285"
                                xmi:uuid="79c9feeb-e023-4810-bfba-7b8888ed6e3c"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//*[@uid and substring-after(@xsi:type,':')='AlternatePartRelationship']"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relatingUid" value="../@uid"/&gt; &lt;sch:let name="relatedUid" value="Related/@uidRef"/&gt; &lt;sch:assert test="not(//*[@uid and substring-after(@xsi:type,':')='AlternatePartRelationship' and ../@uid = $relatingUid and Related/@uidRef = $relatedUid and @uid != $uid])"&gt; The combination of the related part and the relating part shall be unique. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:UR1 -attribute_name:RelatingAndRelatedUids -attribute_value:&lt;sch:value-of select="concat($relatingUid, ',', $relatedUid)"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671463681568_987562_163106"
                             xmi:uuid="b58113df-61ec-4008-9841-44d108e6fbdb"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671463690018_9934_163107"
                                xmi:uuid="34900495-c9a0-424c-9c73-0a01a474e98b"
                                xmi:type="uml:Comment">
                     <body>UR1: SELF\PartRelationship.Relating, SELF\PartRelationship.Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_8db01ea_1513262544955_489366_62958"
                             xmi:uuid="d190dce4-b00f-4510-bc22-935e2bd62544"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417193354_89148_24382"/>
                  <body>the combination of the related part and the relating part shall be unique. </body>
               </ownedComment>
               <name>UR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193015_465238_23387"/>
               <specification xmi:id="_18_4_1_e120334_1499417194200_61794_29793"
                              xmi:uuid="117b05d1-e5c8-49b8-82a8-d24fecf1af69"
                              xmi:type="uml:OpaqueExpression">
                  <body>AlternatePartRelationship::allInstances() -&gt;isUnique(Sequence{Relating, Related})</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
