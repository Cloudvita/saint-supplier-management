         <packagedElement xmi:id="_18_4_1_e120334_1499417193202_327845_23780"
                          xmi:uuid="6023ce41-772d-4239-8ae8-4d35d873bd09"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ProjectRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459331466180_419965_42697"
                       xmi:uuid="76c80a7a-ae64-432d-83c3-575a87ec0aee"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121965_560169_163208"
                             xmi:uuid="088ae474-3dad-42f2-ba0d-9cd3e8cfdbf5"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121966_258087_163209"
                                xmi:uuid="f7c23521-7306-4df4-8d7d-d41cb2d9cd8d"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ProjectRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Project and the relating Project shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ProjectRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459331505535_611367_42699"
                             xmi:uuid="4bf959b9-63c2-4daa-b6ea-7a32525c6aea"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331466180_419965_42697"/>
                  <body>the related Project and the relating Project shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121966_349520_163210"
                             xmi:uuid="a46dbc95-abed-4c7f-bc6d-9ef343e068fb"
                             xmi:type="uml:Comment">
