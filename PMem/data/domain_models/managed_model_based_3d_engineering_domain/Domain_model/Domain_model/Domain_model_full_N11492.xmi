                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324877584_267876_42451"/>
                  <body>the related AssemblyOccurrenceRelationship and the relating AssemblyOccurrenceRelationship shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121193_869496_163010"
                             xmi:uuid="c8420463-fc6f-414a-a800-3e8d217c0ae6"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121193_138703_163011"
                                xmi:uuid="39ada7df-f968-4ad8-a128-9d8b1d5d301d"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121192_667339_163008"
                             xmi:uuid="e839f96e-c2e1-4a52-820b-e1ea55e5e0e8"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121193_475773_163009"
                                xmi:uuid="5e19c86b-8038-4e48-8417-0b8d99d5f49b"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//AssemblyOccurrenceRelationshipSubstitution[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related AssemblyOccurrenceRelationship and the relating AssemblyOccurrenceRelationship shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:AssemblyOccurrenceRelationshipSubstitution.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193022_239766_23405"/>
               <specification xmi:id="_18_4_1_271a0567_1509111382447_13293_30432"
                              xmi:uuid="b7d666cc-5dd3-4496-8003-c99d9391d3c3"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
