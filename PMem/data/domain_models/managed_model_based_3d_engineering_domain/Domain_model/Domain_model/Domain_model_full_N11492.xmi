         <packagedElement xmi:id="_18_4_1_65b021e_1719937607578_601912_150023"
                          xmi:uuid="a298b320-b679-4798-a7c4-9e7df3791bef"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">AssociationObjectRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_65b021e_1719937607584_317073_150027"
                       xmi:uuid="7465d786-cd43-4f97-9288-820c38bacf2a"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1719937607593_536235_150045"
                             xmi:uuid="23c889fb-6090-4566-b231-9abf12be8431"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_65b021e_1719937607584_317073_150027"/>
                  <body>the related and the relating object shall be of same type.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1719937607593_624964_150046"
                             xmi:uuid="baef3547-3f58-463a-bf1d-9679359d7e41"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1719937607596_101867_150075"
                                xmi:uuid="2da1d039-a34f-440c-b7cb-0ec228e10335"
                                xmi:type="uml:Comment">
                     <body>WR1: TYPEOF(Relating) = TYPEOF(Related);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1721730196903_119270_153323"
                             xmi:uuid="daedfd9a-aa0e-42e5-b671-2fe4d2551526"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1721730196904_68704_153324"
                                xmi:uuid="b0874c64-10b6-41e5-a351-596bbaa8f61c"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//AssociationObjectRelationship[@uid]"&gt; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="relating_type" value="if(../@xsi:type) then substring-after(../@xsi:type,':') else ../name()"/&gt; &lt;sch:let name="reference_uidRef" value="Related/@uidRef"/&gt; &lt;sch:let name="reference" value="//*[@uid = $reference_uidRef]"/&gt; &lt;sch:let name="related_type" value="if($reference/@xsi:type) then substring-after($reference/@xsi:type,':') else $reference/name()"/&gt; &lt;sch:assert test="$relating_type = $related_type"&gt; The Related and the Relating object shall be of same type. { -entity_name:&lt;sch:value-of select="$entity_name"/&gt; -entity_uid:&lt;sch:value-of select="$uid"/&gt; -rule_name:WR1 -relating_type:&lt;sch:value-of select="$relating_type"/&gt; -related_type:&lt;sch:value-of select="$related_type"/&gt; } &lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_65b021e_1719937607578_601912_150023"/>
               <specification xmi:id="_18_4_1_65b021e_1719937607592_663456_150044"
                              xmi:uuid="d15ae142-a486-4425-88cb-2c811fbe3b2a"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating.oclType() = self.Related.oclType()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
