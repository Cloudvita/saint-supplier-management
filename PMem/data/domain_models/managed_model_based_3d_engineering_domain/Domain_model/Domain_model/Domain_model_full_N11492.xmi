               <association xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                            xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                            xmi:idref="_18_4_1_271a0567_1550232536771_478061_359296"/>
               <redefinedProperty xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                                  xmi:idref="_18_4_1_271a0567_1522167797712_926801_73886"/>
            </ownedAttribute>
