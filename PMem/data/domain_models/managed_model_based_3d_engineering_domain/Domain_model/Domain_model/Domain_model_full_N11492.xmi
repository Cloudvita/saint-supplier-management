               <ownedComment xmi:id="_18_4_1_65b021e_1671209121699_829189_163120"
                             xmi:uuid="be78450b-2963-403a-86de-724705007075"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121699_128603_163121"
                                xmi:uuid="a27c0e1c-25e6-4e9a-9ee4-1dc28258ab39"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ProductConfigurationRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related ProductConfiguration and the relating ProductConfiguration shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ProductConfigurationRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193197_101410_23772"/>
               <specification xmi:id="_18_4_1_271a0567_1509116207442_704358_31449"
                              xmi:uuid="e9e9d723-03c4-47ed-b0c6-c0341cd95453"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
