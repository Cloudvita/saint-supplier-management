                                xmi:uuid="48b7819e-d656-48bd-abe2-0d470d489038"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193173_498774_23718"/>
               <specification xmi:id="_18_4_1_271a0567_1509115818661_533996_31371"
