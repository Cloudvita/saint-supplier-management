         <packagedElement xmi:id="_18_4_1_e120334_1499417193228_495821_23818"
                          xmi:uuid="56aab8dd-e8ab-4f91-92ab-7072fd4a4f6d"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">RequirementRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459332068802_75350_42718"
                       xmi:uuid="07f81a31-2d5b-4a3e-9709-e9ad0f0df1a6"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121230_383535_163024"
                             xmi:uuid="2dcb8929-bf60-4d40-a05c-39252d029ee3"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121231_611363_163025"
                                xmi:uuid="8534c3ed-b3c4-4764-baae-7b216e185e5d"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//RequirementRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Requirement and the relating Requirement shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:RequirementRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121233_597657_163026"
                             xmi:uuid="619182ab-e64c-457a-9214-0a6456c91bbd"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121233_125105_163027"
                                xmi:uuid="c79b5681-4d3a-43f1-ba66-b1f0e431fe28"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459332100100_23695_42720"
                             xmi:uuid="b3914485-0bcf-48c2-8160-2f91f0042824"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459332068802_75350_42718"/>
                  <body>the related Requirement and the relating Requirement shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193228_495821_23818"/>
               <specification xmi:id="_18_4_1_271a0567_1509116638057_632379_31550"
                              xmi:uuid="15687988-dd05-45f7-b825-dd69dd4289c7"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
