            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">AssemblyViewRelationshipSubstitution</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459324954672_679457_42454"
                       xmi:uuid="dacff5a5-00dd-40af-a043-ef91fb0f57f6"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459324988980_640514_42456"
                             xmi:uuid="0816361f-f112-4757-a429-689d702c1c9c"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324954672_679457_42454"/>
                  <body>the related AssemblyViewRelationship and the relating AssemblyViewRelationship shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121189_78903_163006"
                             xmi:uuid="792474dc-95dd-49b2-a821-ecd550432fbf"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121189_873620_163007"
                                xmi:uuid="3b823d81-7ccf-4295-9f8f-97180db756e0"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121188_33048_163004"
                             xmi:uuid="ee89f0ae-3d12-4f97-b571-9b9bfc19d476"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121189_879937_163005"
                                xmi:uuid="96e39679-55a7-4959-8944-18d3b52f7374"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//AssemblyViewRelationshipSubstitution[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related AssemblyViewRelationship and the relating AssemblyViewRelationship shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:AssemblyViewRelationshipSubstitution.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193023_977979_23408"/>
               <specification xmi:id="_18_4_1_271a0567_1509111561761_824605_30457"
                              xmi:uuid="5532a04e-3331-445a-9dd8-d308fb9f556d"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
