         <packagedElement xmi:id="_18_4_1_e120334_1499417193028_653637_23422"
                          xmi:uuid="a798fd56-ce37-4202-bbc2-3963199fb099"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">BreakdownElementRealization</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459325804892_589486_42482"
                       xmi:uuid="cabf54ca-25b1-41b5-99dc-3b0cacc32769"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459325847967_152726_42484"
                             xmi:uuid="62327a59-a2da-4b26-baad-63fdfe67edf3"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325804892_589486_42482"/>
                  <body> the Relating and the Related shall be different objects.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121896_766057_163164"
                             xmi:uuid="c41c8ae6-5dba-4b94-a5f9-e3c152c8f33c"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121896_959584_163165"
                                xmi:uuid="e19400fa-7640-423a-ae5e-54f8d944c741"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//BreakdownElementRealization[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The Related and the Relating shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:BreakdownElementRealization.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
