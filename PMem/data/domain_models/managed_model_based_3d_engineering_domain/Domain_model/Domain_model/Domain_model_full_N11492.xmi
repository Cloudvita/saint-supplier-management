         <packagedElement xmi:id="_18_4_1_e120334_1499417193293_337205_23922"
                          xmi:uuid="13ea7923-5167-4db4-899a-055f299d8b4e"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">WorkRequestRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459333521945_331139_42767"
                       xmi:uuid="9f071be3-b717-477c-bf17-d7ec036134ba"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121676_717789_163110"
                             xmi:uuid="3e5c6201-3071-4670-a3cd-b1ef802399a9"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121676_280887_163111"
                                xmi:uuid="99491513-fdfd-45f8-87ea-3473e5e19bed"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459333554168_281246_42769"
                             xmi:uuid="4ed188d2-dd82-486f-9bc4-e334677558f6"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459333521945_331139_42767"/>
                  <body>the related WorkRequest and the relating WorkRequest shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121675_230652_163108"
                             xmi:uuid="acb80e20-12a1-4586-b4d0-28cf33826816"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121676_111975_163109"
                                xmi:uuid="5a75c0be-2edf-4730-ac70-72bb310f8c4c"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//WorkRequestRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related WorkRequest and the relating WorkRequest shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:WorkRequestRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193293_337205_23922"/>
               <specification xmi:id="_18_4_1_271a0567_1509117489066_521429_31646"
                              xmi:uuid="5fd02914-da23-4740-ac58-54aba0a0c7e8"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <generalization xmi:id="_18_4_1_65b021e_1675863858547_419829_164155"
