         <packagedElement xmi:id="_18_4_1_e120334_1499417193025_577371_23412"
                          xmi:uuid="39acd07e-4796-4027-a6d7-015af2217cb8"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">AxisPlacement</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459325082659_688993_42460"
                       xmi:uuid="19e3a9b9-c553-44df-b08b-74671fdf34cb"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671446160826_484148_162891"
                             xmi:uuid="2460c618-dae0-4892-be3e-cdba153255af"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671446169791_286685_162892"
                                xmi:uuid="73301ee9-573a-4221-aa2a-e490222da390"
                                xmi:type="uml:Comment">
                     <body>WR1: SIZEOF(RefDirection) = SIZEOF(Position);</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459325348945_751887_42462"
                             xmi:uuid="2c3b4dc6-458e-4757-9660-fb7bad190b22"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459325082659_688993_42460"/>
                  <body> if RefDirection is defined, its dimensionality shall be the same than the dimensionality of Position.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943680_235007_151478"
                             xmi:uuid="df2de9c8-08ad-4c7e-b301-421cb872e2c4"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943680_718572_151479"
                                xmi:uuid="0f0ef7df-06de-4aba-bca1-d9ad6fea62db"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(RefDirection) or (count(tokenize(normalize-space(RefDirection), ' '))= count(tokenize(normalize-space(Position), ' ')))"&gt; (AxisPlacement_WR1 &lt;sch:value-of select="$uid"/&gt;) if RefDirection is defined, its dimensionality shall be the same than the dimensionality of Position.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_577371_23412"/>
               <specification xmi:id="_18_4_1_271a0567_1509023270410_282668_30084"
                              xmi:uuid="cb9bcacb-1a8d-4392-bb08-313adb7baffc"
                              xmi:type="uml:OpaqueExpression">
                  <body>(self.RefDirection-&gt;size() &gt; 0) implies (self.RefDirection-&gt;size() = self.Position-&gt;size())</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_e120334_1499417193399_376746_24804"
                       xmi:uuid="2cfd6823-8c44-421c-94e1-70695fc83e91"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_271a0567_1516182257985_854636_74398"
                             xmi:uuid="2ae5df5c-6e3f-467a-a98c-541296e0deb0"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417193399_376746_24804"/>
                  <body>if RefDirection is defined, its dimensionality shall be 2 or 3.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943646_811260_151470"
                             xmi:uuid="9317f1ac-1c07-417e-9481-def57e6b6bb7"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943647_238077_151471"
                                xmi:uuid="3cace66e-1254-43cb-bc26-e47e918afdea"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(RefDirection) or (count(tokenize(normalize-space(RefDirection), ' '))=2) or (count(tokenize(normalize-space(RefDirection), ' '))=3)"&gt; (AxisPlacement_RefDirectionLowerBound &lt;sch:value-of select="$uid"/&gt;) if RefDirection is defined, its dimensionality shall be 2 or 3.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>RefDirectionLowerBound</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_577371_23412"/>
               <specification xmi:id="_18_4_1_e120334_1499417194234_144900_30101"
                              xmi:uuid="c1b0798e-8a15-4008-ad90-1e49266737d6"
                              xmi:type="uml:OpaqueExpression">
                  <body>RefDirection-&gt;isEmpty () xor (RefDirection-&gt;size () &gt;= 2)</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_271a0567_1548167014649_896215_294950"
                       xmi:uuid="2e307348-e361-41ca-84ef-18f4dad9db89"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_271a0567_1548167271422_380143_294952"
                             xmi:uuid="8480a5ac-a79d-48be-a82e-d3435f2a0dc4"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_271a0567_1548167014649_896215_294950"/>
                  <body>the attribute Axis shall be unset in the 2D case because it defines the z-Direction of the local coordinate system. </body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943688_465092_151480"
                             xmi:uuid="c971e38d-8c5f-4de0-8db0-1f332bd1e5b7"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943689_215909_151481"
                                xmi:uuid="1dda6b49-a26a-44b3-823f-af3a63fcd294"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(count(tokenize(normalize-space(Position), ' '))=2) or not(Axis)"&gt; (AxisPlacement_NoAxisDefinedFor2DAxisPlacement &lt;sch:value-of select="$uid"/&gt;) the attribute Axis shall be unset in the 2D case because it defines the z-Direction of the local coordinate system.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>NoAxisDefinedFor2DAxisPlacement</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_577371_23412"/>
               <specification xmi:id="_18_4_1_271a0567_1548167014651_747852_294951"
                              xmi:uuid="618af18b-e3a2-4d44-986a-d91a0db63451"
                              xmi:type="uml:OpaqueExpression">
                  <body>(self.Position-&gt;size() = 2) implies (self.Axis-&gt;isEmpty())</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_65b021e_1673259932651_142094_163278"
                       xmi:uuid="608ab386-d169-4a6a-b67b-ba2e5bfbe1a6"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943656_815735_151472"
                             xmi:uuid="4b3ec6fb-bcc6-4f33-8f94-4c7fa2aec531"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943656_658782_151473"
                                xmi:uuid="2a8f4f6a-d645-4f0f-9363-f17abb21fdbc"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="not(Position) or count(tokenize(normalize-space(Position), ' '))= 2 or count(tokenize(normalize-space(Position), ' '))=3"&gt; (AxisPlacement_WR3 &lt;sch:value-of select="$uid"/&gt;) Position shall be either undefined or its size shall be 2 or 3.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1673259932657_652708_163281"
                             xmi:uuid="6ad8513d-8b4b-442d-9504-430854759999"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_65b021e_1673259932651_142094_163278"/>
                  <body>Position shall be either undefined or its size shall be 2 or 3.</body>
               </ownedComment>
               <name>WR3</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_577371_23412"/>
               <specification xmi:id="_18_4_1_65b021e_1673259932656_902728_163280"
                              xmi:uuid="fefe6e88-6af8-4156-a67e-c3a5cc360acb"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Position-&gt;isEmpty() xor (Position-&gt;size() &gt;= 2)</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_65b021e_1673259932655_662703_163279"
                       xmi:uuid="8050d8ef-cfde-4c2e-a4ba-e0a33e7dc7cb"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1673259932657_846463_163283"
                             xmi:uuid="66fc111f-563d-4dac-881c-98bd1d376eb5"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_65b021e_1673259932655_662703_163279"/>
                  <body>an AxisPlacement shall be either externally or locally defined.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943664_278318_151474"
                             xmi:uuid="9bbe2c06-cedf-4dd9-a842-30d203df9205"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714741943664_745788_151475"
                                xmi:uuid="6c78c50c-04d7-4e1b-8720-dfd8c40aee42"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='AxisPlacement']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:assert test="External and not(Position) or not(External) and Position"&gt; (AxisPlacement_WR4 &lt;sch:value-of select="$uid"/&gt;) an AxisPlacement shall be either externally or locally defined.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR4</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193025_577371_23412"/>
               <specification xmi:id="_18_4_1_65b021e_1673259932657_588658_163282"
                              xmi:uuid="4f2b77fe-4c4f-4fbe-9c77-ba6e0b426a9f"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Position-&gt;isEmpty() xor self.External-&gt;isEmpty()</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_e120334_1499417193399_47594_24803"
                       xmi:uuid="93bb14f9-d56b-4cd0-96f8-91dbd247a9e7"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_271a0567_1516182212539_637299_74395"
                             xmi:uuid="cd1cbe06-a797-4976-b4be-423b41edb481"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_e120334_1499417193399_47594_24803"/>
                  <body>if Axis is defined, its dimensionality shall be 3.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1714741943673_656800_151476"
                             xmi:uuid="e5df69ec-3aeb-4d23-9a26-acf7995f84b9"
