         <packagedElement xmi:id="_18_4_1_e120334_1499417193079_200378_23527"
                          xmi:uuid="da802bcd-ca18-4afa-a18d-9f99a0f075d8"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">DocumentDefinitionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459327408276_679107_42544"
                       xmi:uuid="e2f1836c-16b6-410c-ad98-81c56c79191f"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459327440669_315046_42546"
                             xmi:uuid="16df538a-3062-43c3-bcf4-ae5a30f188be"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459327408276_679107_42544"/>
                  <body>the related DocumentDefinition and the relating DocumentDefinition shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121783_714674_163144"
                             xmi:uuid="780f66bf-c5ad-40ed-a48d-a806fd31535d"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121783_82723_163145"
                                xmi:uuid="decbece8-e42e-49b9-8d31-9f9d66a28264"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//DocumentDefinitionRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related DocumentDefinition and the relating DocumentDefinition shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:DocumentDefinitionRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121784_455898_163146"
                             xmi:uuid="f562cab0-0272-48af-ae79-ddea414cc9fb"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121784_908018_163147"
                                xmi:uuid="e6005e61-061c-4efa-afef-ad570be2165d"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193079_200378_23527"/>
               <specification xmi:id="_18_4_1_271a0567_1509113412684_506509_31115"
                              xmi:uuid="eb1161d1-0587-40e8-b7b1-e0320e15e1fa"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
