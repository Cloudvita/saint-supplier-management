                                xmi:uuid="0a53a68c-e4a6-4f9f-8319-ab96378c7dfa"
                                xmi:type="uml:Comment">
                     <body>WR1: DimensionCount &gt; 0;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193112_722991_23591"/>
               <specification xmi:id="_18_4_1_271a0567_1509037208774_563746_30632"
                              xmi:uuid="03b389ab-65fa-4715-9959-de9b803d9ba3"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.DimensionCount &gt; 0</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
