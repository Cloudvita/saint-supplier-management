            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">Cartesian11</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_4_1_271a0567_1548346721478_42585_100086"
                       xmi:uuid="eaaf6f95-fcdf-4b8a-8e6d-1bb5d327fb4e"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1714997368217_795746_151620"
                             xmi:uuid="9bca09bd-6442-408e-a88b-82a26d80d89b"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714997368217_482957_151621"
                                xmi:uuid="49b5c75f-2183-4864-ac84-8fb997308c18"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//RepresentationItem[@uid and substring-after(@xsi:type,':')='Cartesian11']"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="axisPlacementRef" value="child::Placement/@uidRef"/&gt; &lt;!-- assumption delimiter in AxisPlacement/Position is blank --&gt; &lt;sch:assert test="count(tokenize(normalize-space(//RepresentationItem[@uid=$axisPlacementRef]/Position) , ' '))=3"&gt;(Cartesian11.WR1 &lt;sch:value-of select="$uid"/&gt;) the dimensionality of the Placement shall be 3.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_271a0567_1548758174002_327267_347841"
                             xmi:uuid="db76a402-332a-4b05-88a9-222dde68a4f6"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_4_1_271a0567_1548346721478_42585_100086"/>
                  <body>the dimensionality of the Placement shall be 3.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_8db01ea_1533118332505_166459_94651"/>
               <specification xmi:id="_18_4_1_271a0567_1548346721490_287038_100087"
                              xmi:uuid="f97be4a0-ed79-48a9-a198-21b356f219a8"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Placement.Position-&gt;size() = 3</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
