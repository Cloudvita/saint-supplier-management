                     <instance href="../../../../SysML_ARM/SYSML_ARM_AP242.xmi#_1_enumitem_SYSML_ARM-actuated_direction-not_actuated"/>
                  </value>
               </slot>
            </ownedLiteral>
            <ownedLiteral xmi:id="_19_0_4_2840147_1723462948691_973309_61360"
