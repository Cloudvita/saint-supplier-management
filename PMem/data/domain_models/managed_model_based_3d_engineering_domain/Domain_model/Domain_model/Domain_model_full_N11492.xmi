         <packagedElement xmi:id="_18_4_1_e120334_1499417193058_419761_23484"
                          xmi:uuid="53f2e42f-f764-4dae-9861-b86805ca5cb2"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ContractRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459326989265_200978_42528"
                       xmi:uuid="c5c0414b-a841-4144-8a7c-9087dd87941e"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121932_791390_163188"
                             xmi:uuid="27d08149-79fc-4092-ae50-a44b3e2ee4fc"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121932_705193_163189"
                                xmi:uuid="f99cb9af-ad23-4dac-887a-c18a5a17ae65"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//ContractRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Contract and the relating Contract shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:ContractRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121932_996687_163190"
                             xmi:uuid="29b2b6d7-dd3e-4f9f-8b52-2d8b5d09d5de"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121932_676842_163191"
                                xmi:uuid="af046799-a89f-4409-9de1-a9b348de604f"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459327023639_366788_42530"
                             xmi:uuid="41c2c147-b81b-4b6c-b144-0fa48267380a"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459326989265_200978_42528"/>
                  <body>the related Contract and the relating Contract shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193058_419761_23484"/>
               <specification xmi:id="_18_4_1_271a0567_1509112749173_103039_30888"
                              xmi:uuid="c5c75546-70d2-4359-9fad-21963d1ca56a"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
