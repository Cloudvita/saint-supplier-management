         <packagedElement xmi:id="_18_4_1_e120334_1499417193088_522849_23541"
                          xmi:uuid="2950cc12-866e-45f5-9279-cd8ab4a57971"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">EffectivityRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459327736254_482456_42553"
                       xmi:uuid="cde58b5b-4bb6-461c-b007-6c089e0c31ba"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121420_904775_163068"
                             xmi:uuid="5825a349-6f4d-4108-bd76-a9dbd973652a"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121421_708702_163069"
                                xmi:uuid="0a6a0d0f-27cb-47e8-9f20-a29965094135"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//EffectivityRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related Effectivity and the relating Effectivity shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:EffectivityRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459327775798_463644_42555"
                             xmi:uuid="9adf6558-147e-4873-b324-72f520f74ffe"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459327736254_482456_42553"/>
                  <body>the related Effectivity and the relating Effectivity shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121421_219789_163070"
                             xmi:uuid="e219bcba-7d0f-4f9d-8fac-5a38bf829cea"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121421_877946_163071"
                                xmi:uuid="5337beb7-5bf2-48cc-8980-00e08e0adfd5"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193088_522849_23541"/>
               <specification xmi:id="_18_4_1_271a0567_1509113580204_570694_31153"
                              xmi:uuid="10274bce-8689-40d8-8eed-33d1e5ece9bb"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
