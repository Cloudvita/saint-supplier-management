         <packagedElement xmi:id="_18_4_1_e120334_1499417193133_57201_23623"
                          xmi:uuid="6ee656de-8a9d-4a8b-b1a8-8866ba8c5b16"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">InformationUsageRightRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459329511415_944356_42611"
                       xmi:uuid="197e4161-dd98-4a68-8b8f-4b4ba1ffc227"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121944_405872_163194"
                             xmi:uuid="90df0827-96d8-4e15-ad3a-ae3e36ded7d3"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121944_209593_163195"
                                xmi:uuid="b14fab76-b5af-42b5-bc45-ec653a349622"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459329540504_961381_42613"
                             xmi:uuid="a1deff01-99d6-4799-8e9d-498236864c7a"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329511415_944356_42611"/>
                  <body>the related InformationUsageRight and the relating InformationUsageRight shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121943_216235_163192"
                             xmi:uuid="f7825a05-e3be-497c-9888-7ddb1acb02af"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121943_338356_163193"
                                xmi:uuid="ffd7ada5-bd1a-4f3f-8fed-e45df9be6ccb"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//InformationUsageRightRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related InformationUsageRight and the relating InformationUsageRight shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:InformationUsageRightRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193133_57201_23623"/>
               <specification xmi:id="_18_4_1_271a0567_1511355417752_751879_33390"
                              xmi:uuid="9ed244ae-f317-4b5e-97ef-476a6be9d4ac"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
