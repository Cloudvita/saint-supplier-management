            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_19_0_4_b1702d9_1702999985774_352026_59953"
                       xmi:uuid="4662b5ff-7926-4b1e-b916-c24c6c5d5275"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_19_0_4_b1702d9_1703001711796_326119_62706"
                             xmi:uuid="5d4ebf01-ee23-4e84-a7a5-9f51e68079bb"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702999985774_352026_59953"/>
               </ownedComment>
               <ownedComment xmi:id="_19_0_4_b1702d9_1702999986301_298799_60099"
                             xmi:uuid="7c98920e-2aed-4410-8544-ca1c4e8f06be"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_19_0_4_b1702d9_1702999986326_71987_60310"
                                xmi:uuid="291a9f71-5f1c-4dfb-90ed-f3b3fe38a1f3"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//DeltaChangeRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related DeltaChange and the relating DeltaChange shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:DeltaChangeRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_19_0_4_b1702d9_1702999986301_884624_60100"
                             xmi:uuid="aeaf5b4a-566a-4464-9472-31f8b8693fd5"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_19_0_4_b1702d9_1702999986326_427992_60311"
                                xmi:uuid="46372592-6f3f-4ed1-b963-ed605d798d58"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_19_0_4_b1702d9_1702999986301_217018_60098"
                             xmi:uuid="dc531d76-5fde-4a42-802f-12330480af98"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_19_0_4_b1702d9_1702999985774_352026_59953"/>
                  <body>the related DeltaChange and the relating DeltaChange shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_19_0_4_b1702d9_1702999985772_264060_59952"/>
               <specification xmi:id="_19_0_4_b1702d9_1702999986301_859594_60097"
                              xmi:uuid="c7ebc23c-2d41-46a8-806f-2788696934e1"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
