         <packagedElement xmi:id="_18_4_1_e120334_1499417193016_717404_23389"
                          xmi:uuid="08476633-714f-4557-8225-6d557d09d322"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">AlternativeSolutionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459324241633_399665_42432"
                       xmi:uuid="2e7049e8-8256-44ac-b360-e9f65d91a316"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121920_426663_163184"
                             xmi:uuid="0b336fd8-fcce-47ae-8c96-f33a6f190e76"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121920_198632_163185"
                                xmi:uuid="605d411c-c08b-44f2-b61c-b6e6c49d7c6a"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//AlternativeSolutionRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related AlternativeSolution and the relating AlternativeSolution shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:AlternativeSolutionRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121920_96733_163186"
                             xmi:uuid="8deaa431-49b1-4692-bb84-3b282a15bab9"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121921_85628_163187"
                                xmi:uuid="8d34c639-1419-4c80-a1f5-39e90f830a5e"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459324279166_537724_42434"
                             xmi:uuid="f8bc993e-29cd-4cd4-ac1a-be9df9a4e283"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459324241633_399665_42432"/>
                  <body>the related AlternativeSolution and the relating AlternativeSolution shall be different.</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193016_717404_23389"/>
               <specification xmi:id="_18_4_1_271a0567_1508942714305_902212_33322"
                              xmi:uuid="933298f1-662a-49be-a815-a3ebd5a6a9d3"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
