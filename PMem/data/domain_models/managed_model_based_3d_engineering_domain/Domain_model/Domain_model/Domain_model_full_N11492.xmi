         <packagedElement xmi:id="_18_4_1_e120334_1499417193187_326713_23756"
                          xmi:uuid="d6269b9f-e676-451f-a80f-2701e9055b7b"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">ProcessedCore</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459331143161_903813_42688"
                       xmi:uuid="aeb27267-1a10-48c3-b411-a6faaa6c687b"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1714997368203_279169_151616"
                             xmi:uuid="0059c8e1-94c4-4c31-a99a-e3399374cde3"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1714997368204_788200_151617"
                                xmi:uuid="fcd87644-b420-40e7-9983-e4614422b470"
                                xmi:type="uml:Comment">
                     <body>&lt;sch:rule context="//PartView[@uid and substring-after(@xsi:type,':')='ProcessedCore' ]"&gt; &lt;sch:let name="uid" value="@uid"/&gt; &lt;sch:let name="stockMaterialRef" value="MadeFromStock/@uidRef"/&gt; &lt;sch:assert test="//*[@uid=$stockMaterialRef]/StockMaterialType = 'stock_core'"&gt;(ProcessedCore.WR1 &lt;sch:value-of select="$uid"/&gt;) the StockMaterial of a ProcessedCore shall be of type stock_core.&lt;/sch:assert&gt; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459331190719_262994_42690"
                             xmi:uuid="acb2e26a-2d3f-4b38-94c1-dfb3395231d6"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331143161_903813_42688"/>
                  <body> the StockMaterial of a ProcessedCore shall be of type stock_core.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671456518466_660031_163070"
                             xmi:uuid="f020a16f-fccb-47f4-a5be-0a239cd18b10"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671456506827_81898_163069"
                                xmi:uuid="3718c506-393a-4445-a9de-d20de013858c"
                                xmi:type="uml:Comment">
                     <body>WR1: SELF.MadeFromStock.StockMaterialType = stock_core;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193187_326713_23756"/>
               <specification xmi:id="_18_4_1_271a0567_1509355226746_701501_30733"
                              xmi:uuid="dad84969-116a-4036-a201-fb2917938e83"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.MadeFromStock.StockMaterialType = Application_protocols::AP242::Domain_model::CompositeStructuralShapeAndStructure::StockCategoryEnum::stock_core</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
