         <packagedElement xmi:id="_18_4_1_e120334_1499417193213_689554_23793"
                          xmi:uuid="5290494a-1e1f-41e8-a3f2-f8fa75f2da2e"
                          xmi:type="uml:Class">
            <name xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">PropertyValueRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459331927425_652952_42712"
                       xmi:uuid="e83f409f-b280-432a-a686-176914a1cf90"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121415_389145_163062"
                             xmi:uuid="2d94984c-93f4-4c81-93df-246f34fda70a"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121415_239481_163063"
                                xmi:uuid="881f1480-5e20-4932-83a6-adf2e7d5d2c6"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_0_5_45e01bd_1459331970266_373969_42714"
                             xmi:uuid="a1ba8f06-56c8-4dff-afd6-b4cd100aa883"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459331927425_652952_42712"/>
                  <body>the related PropertyValue and the relating PropertyValue shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121415_386539_163060"
                             xmi:uuid="a8549560-2be6-4d2e-8ffd-8d312ae6265b"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121415_917166_163061"
                                xmi:uuid="58104b21-f2f6-447b-a1ed-fcf3fed691e0"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//PropertyValueRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related PropertyValue and the relating PropertyValue shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:PropertyValueRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193213_689554_23793"/>
               <specification xmi:id="_18_4_1_271a0567_1509116491862_789211_31520"
                              xmi:uuid="108519f4-1a1a-49f8-8667-4c31257dc223"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
