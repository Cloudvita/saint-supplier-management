                  xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile">IndividualPartVersionRelationship</name>
            <ownedRule xmlns:sysml="http://www.omg.org/spec/SysML/20150709/SysML"
                       xmlns:StandardProfile="http://www.omg.org/spec/UML/20131001/StandardProfile"
                       xmi:id="_18_0_5_45e01bd_1459329354515_694298_42605"
                       xmi:uuid="18f1047f-4856-4ec8-9166-38095f1bb324"
                       xmi:type="uml:Constraint">
               <ownedComment xmi:id="_18_0_5_45e01bd_1459329381225_543961_42607"
                             xmi:uuid="2517a8cc-7542-4c73-a37b-6c0a49fbc0bc"
                             xmi:type="uml:Comment">
                  <annotatedElement xmi:idref="_18_0_5_45e01bd_1459329354515_694298_42605"/>
                  <body>the related IndividualPartVersion and the relating IndividualPartVersion shall be different.</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121311_641191_163042"
                             xmi:uuid="e400fe56-cf6e-45f0-b464-ada6bc5ecda0"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121311_855493_163043"
                                xmi:uuid="b233b70e-27ef-4e13-8fca-14d99198c5b5"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <ownedComment xmi:id="_18_4_1_65b021e_1671209121310_153872_163040"
                             xmi:uuid="ec8b1c37-199c-4315-b634-ccab55640350"
                             xmi:type="uml:Comment">
                  <ownedComment xmi:id="_18_4_1_65b021e_1671209121311_893188_163041"
                                xmi:uuid="1cf45965-8ca1-41a9-b66a-93230cd6bb40"
                                xmi:type="uml:Comment">
                     <body> &lt;sch:rule context="//IndividualPartVersionRelationship[@uid]"&gt;&#xD; &lt;sch:let name="entity_name" value="if(@xsi:type) then substring-after(@xsi:type,':') else name()"/&gt;&#xD; &lt;sch:let name="uid" value="@uid"/&gt;&#xD; &lt;sch:let name="uidRelating" value="../@uid"/&gt;&#xD; &lt;sch:let name="uidRelated" value="Related/@uidRef"/&gt;&#xD; &lt;sch:assert test="not(../@uid = Related/@uidRef)"&gt;&#xD; The related IndividualPartVersion and the relating IndividualPartVersion shall be different. &#xD; {&#xD; -entity_name:&lt;sch:value-of select="$entity_name"/&gt;&#xD; -entity_uid:&lt;sch:value-of select="$uid"/&gt; &#xD; -rule_name:IndividualPartVersionRelationship.WR1&#xD; -relating:&lt;sch:value-of select="$uidRelating"/&gt;&#xD; -related:&lt;sch:value-of select="$uidRelated"/&gt;&#xD; }&#xD; &lt;/sch:assert&gt;&#xD; &lt;/sch:rule&gt;</body>
                  </ownedComment>
                  <body>Schematron</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193127_114269_23616"/>
               <specification xmi:id="_18_4_1_271a0567_1509114547981_214269_31255"
                              xmi:uuid="1ecb3c0e-a855-4dde-acf5-f464422d962d"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
            </ownedRule>
