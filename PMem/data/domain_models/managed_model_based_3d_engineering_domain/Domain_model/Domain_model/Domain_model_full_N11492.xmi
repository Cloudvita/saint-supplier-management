                                xmi:uuid="51d9327f-fe92-4c52-a568-5073b54a5a35"
                                xmi:type="uml:Comment">
                     <body>WR1: Relating :&lt;&gt;: Related;</body>
                  </ownedComment>
                  <body>EXPRESS</body>
               </ownedComment>
               <name>WR1</name>
               <constrainedElement xmi:idref="_18_4_1_e120334_1499417193202_327845_23780"/>
               <specification xmi:id="_18_4_1_271a0567_1509116271540_889489_31465"
                              xmi:uuid="cb704171-ef6f-40a4-a484-05593a7ccf92"
                              xmi:type="uml:OpaqueExpression">
                  <body>self.Relating &lt;&gt; self.Related</body>
                  <language>OCL2.0</language>
               </specification>
